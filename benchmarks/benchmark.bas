10 REM NextBASIC benchmark: the same seven tasks as benchmark.lz80n
20 RUN AT 3: LAYER 0: CLS: DIM t(7): LET k=0
30 PRINT "NextBASIC benchmark, 28 MHz": PRINT "running..."
100 GO SUB 9000: FOR i=1 TO 10000: NEXT i: GO SUB 9100
110 GO SUB 9000: LET s=0: FOR i=1 TO 5000: LET s=s+i*7: LET s=s-INT (s/1000)*1000: NEXT i: GO SUB 9100
120 GO SUB 9000: DIM f(2000): FOR i=1 TO 2000: LET f(i)=1: NEXT i: LET c=0
121 FOR i=2 TO 1999: IF f(i+1)=1 THEN LET c=c+1: FOR j=i+i TO 1999 STEP i: LET f(j+1)=0: NEXT j
122 NEXT i: GO SUB 9100
130 GO SUB 9000: FOR i=1 TO 500: PRINT AT 20,2;"LZ80N speed test": NEXT i: GO SUB 9100
140 GO SUB 9000: FOR n=1 TO 20: LET a$="": FOR i=1 TO 50: LET a$=a$+CHR$ (65+i-INT (i/26)*26): NEXT i: NEXT n: GO SUB 9100
150 GO SUB 9000: LET q=0: FOR i=1 TO 1000: LET q=q+INT SQR i: NEXT i: GO SUB 9100
160 LAYER 2,1: GO SUB 9000: FOR y=120 TO 183: FOR x=0 TO 127: PLOT x,y: NEXT x: NEXT y: GO SUB 9100
200 LAYER 0: CLS: PRINT "NextBASIC benchmark, 28 MHz": PRINT
210 RESTORE 900: FOR n=1 TO 7: READ n$: PRINT n$;TAB 10;t(n);" ms": NEXT n
220 PRINT: PRINT "arith ";s;"  primes ";c;"  sqrt ";q
230 STOP
900 DATA "loop","arith","sieve","print","string","sqrt","plot"
9000 LET t0=PEEK 23672+256*PEEK 23673+65536*PEEK 23674: RETURN
9100 LET k=k+1: LET t(k)=(PEEK 23672+256*PEEK 23673+65536*PEEK 23674-t0)*20: RETURN
