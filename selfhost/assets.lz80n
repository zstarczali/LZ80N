const MAX_FRAMES = 60000
const NO_TARGET = -1

far byte md[65535]          -- the module
word mlen = 0
byte version = 0
byte tsel = 0               -- the note table
bool vol35 = false

function mb(long o) -> byte
    if o >= mlen then
        fail_m("not a valid .pt3 module (data past the end of the file)")
        return 0
    end
    return md[word(o)]
end

function le16(long o) -> word
    return word(mb(o)) | word(mb(o + 1)) << 8
end

function tone_of(long half) -> long
    if half < 0 then half = 0 end
    if half > 95 then half = 95 end
    byte h = byte(half)
    if tsel == 1 then return tab_st[h] end
    if tsel == 2 then return tab_asm_3[h] end
    if tsel == 3 then return tab_asm_4[h] end
    if tsel == 4 then return tab_real_3[h] end
    if tsel == 5 then
        if h == 43 then return 0x0112 end
        return tab_real_3[h]
    end
    if tsel == 6 then return tab_natural[h] end
    if tsel == 7 then return tab_pt3_3[h] end
    return tab_pt3_4[h]
end

function voltab(word i) -> byte
    if vol35 then return vol_35[i] end
    return vol_33_34[i]
end

-- samples (0 lines: silent) and ornaments (offset 0: one offset 0)
word smp_off[32]
word smp_len[32]
word smp_loop[32]
word orn_off[16]
word orn_len[16]
word orn_loop[16]

-- byte k (0..3) of line i of sample s (the silent line: 1, $90, 0, 0)
function smp_byte(word s, word i, byte k) -> byte
    if smp_len[s] == 0 then
        if k == 0 then return 1 end
        if k == 1 then return 0x90 end
        return 0
    end
    return mb(long(smp_off[s]) + 2 + long(i) * 4 + k)
end

function orn_at(word o, word i) -> long
    if orn_len[o] == 0 then return 0 end
    return long(sbyte(mb(long(orn_off[o]) + 2 + i)))
end

-- sliders: 0..2 the channels, 3 the envelope
long sl_period[4]
long sl_counter[4]
long sl_delta[4]
long sl_value[4]

function sl_update(byte i) -> bool
    if sl_counter[i] ~= 0 then
        sl_counter[i] -= 1
        if sl_counter[i] == 0 then
            sl_value[i] += sl_delta[i]
            sl_counter[i] = sl_period[i]
            return true
        end
    end
    return false
end

function sl_reset(byte i)
    sl_counter[i] = 0
    sl_value[i] = 0
end

-- channels
word c_ptr[3]
word c_skip[3]
word c_left[3]
bool c_enabled[3]
bool c_env[3]
long c_note[3]
long c_prev[3]
word c_sample[3]
word c_pos_s[3]
word c_orn[3]
word c_pos_o[3]
long c_volume[3]
long c_vol_slide[3]
long c_target[3]
long c_slide_delta[3]
long c_tone_acc[3]
long c_env_sliding[3]
long c_noise_sliding[3]
long c_vib_counter[3]
long c_vib_on[3]
long c_vib_off[3]

word tempo = 1
long env_base = 0
long noise_base = 0
long noise_addon = 0
byte regs[14]
bool env_write = false

function nextb(byte c) -> byte
    byte b = mb(c_ptr[c])
    c_ptr[c] += 1
    return b
end

function next16(byte c) -> long
    long lo = nextb(c)
    return lo | long(nextb(c)) << 8
end

function s16(long v) -> long
    if v >= 32768 then return v - 65536 end
    return v
end

function start_pattern(word pat)
    long base = long(le16(103)) + long(pat) * 6
    for c = 0, 2 do
        c_ptr[c] = le16(base + c * 2)
        c_skip[c] = 1
        c_left[c] = 0
    end
end

-- the effects of a cell
byte fx[64]
byte ef_k[64]
long ef_p1[64]
long ef_p2[64]

-- read the next cell of channel c and apply it
function cell(byte c)
    byte nfx = 0
    bool has_note = false
    long note = 0
    byte en = 0                 -- 0 unchanged, 1 on, 2 off
    byte envk = 0               -- 0 unchanged, 1 on (env_ty, env_per), 2 off
    byte env_ty = 0
    long env_per = 0
    bool has_smp = false
    word smp = 0
    bool has_orn = false
    word orn = 0
    bool has_vol = false
    long vol = 0
    bool has_noise = false
    long nz_v = 0
    while not failed do
        byte cmd = nextb(c)
        if cmd <= 0x0F then
            if nfx < 64 then
                fx[nfx] = cmd
                nfx += 1
            end
        elseif (cmd >= 0x10 and cmd <= 0x1F) or (cmd >= 0xB2 and cmd <= 0xBF) or cmd >= 0xF0 then
            if cmd >= 0x11 and cmd <= 0xBF then
                if cmd >= 0xB2 then env_ty = cmd - 0xB1 else env_ty = cmd - 0x10 end
                long hi = nextb(c)
                env_per = hi << 8 | long(nextb(c))
                envk = 1
            else
                envk = 2
            end
            if cmd >= 0xF0 then
                has_orn = true
                orn = cmd - 0xF0
            end
            if not (cmd >= 0xB2 and cmd <= 0xBF) then
                byte sv = nextb(c)
                has_smp = true
                if sv < 64 and sv & 1 == 0 then smp = sv / 2 else smp = 0 end
            end
        elseif cmd >= 0x20 and cmd <= 0x3F then
            has_noise = true
            nz_v = cmd - 0x20
        elseif cmd >= 0x40 and cmd <= 0x4F then
            has_orn = true
            orn = cmd - 0x40
        elseif cmd >= 0x50 and cmd <= 0xAF then
            has_note = true
            note = cmd - 0x50
            en = 1
            break
        elseif cmd == 0xB0 then
            envk = 2
        elseif cmd == 0xB1 then
            byte n = nextb(c)
            if n == 0 then n = 1 end
            c_skip[c] = n
        elseif cmd == 0xC0 then
            en = 2
            break
        elseif cmd >= 0xC1 and cmd <= 0xCF then
            has_vol = true
            vol = cmd - 0xC0
        elseif cmd == 0xD0 then
            break
        else
            has_smp = true
            smp = cmd - 0xD0
        end
    end
    -- the effect parameters follow the note, the last effect first
    byte nef = 0
    bool slide_fx = false
    byte i = nfx
    while i > 0 and not failed do
        i -= 1
        byte e = fx[i]
        if e == 1 or e == 8 then
            ef_k[nef] = e
            ef_p1[nef] = nextb(c)
            ef_p2[nef] = s16(next16(c))
            nef += 1
        elseif e == 2 then
            ef_k[nef] = 2
            ef_p1[nef] = nextb(c)
            next16(c)
            ef_p2[nef] = s16(next16(c))
            nef += 1
            slide_fx = true
        elseif e == 3 or e == 4 then
            ef_k[nef] = e
            ef_p1[nef] = nextb(c)
            ef_p2[nef] = 0
            nef += 1
        elseif e == 5 then
            ef_k[nef] = 5
            ef_p1[nef] = nextb(c)
            ef_p2[nef] = nextb(c)
            nef += 1
        elseif e == 9 then
            byte t = nextb(c)
            if t > 0 then tempo = t end
        end
    end
    if failed then return end
    long prev_slide = sl_value[c]
    if en ~= 0 then
        c_pos_s[c] = 0
        c_pos_o[c] = 0
        c_vol_slide[c] = 0
        c_env_sliding[c] = 0
        c_noise_sliding[c] = 0
        sl_reset(c)
        c_tone_acc[c] = 0
        c_vib_counter[c] = 0
        c_enabled[c] = en == 1
    end
    if has_note then
        if slide_fx then
            if c_target[c] == NO_TARGET then c_prev[c] = c_note[c] end
        else
            c_prev[c] = note
        end
        c_note[c] = note
    end
    if has_smp then c_sample[c] = smp end
    if has_orn then
        c_orn[c] = orn
        c_pos_o[c] = 0
    end
    if has_vol then c_volume[c] = vol end
    if has_noise then noise_base = nz_v end
    if envk == 1 then
        regs[13] = env_ty
        env_write = true
        env_base = env_per
        sl_reset(3)
        c_env[c] = true
        c_pos_o[c] = 0
    elseif envk == 2 then
        c_env[c] = false
        c_pos_o[c] = 0
    end
    byte k = 0
    while k < nef do
        byte e = ef_k[k]
        long p1 = ef_p1[k]
        long p2 = ef_p2[k]
        if e == 1 then
            sl_period[c] = p1
            sl_counter[c] = p1
            sl_delta[c] = p2
            c_target[c] = NO_TARGET
            c_vib_counter[c] = 0
            if sl_counter[c] == 0 and version >= 7 then sl_counter[c] += 1 end
        elseif e == 2 then
            long diff = tone_of(c_note[c]) - tone_of(c_prev[c])
            c_vib_counter[c] = 0
            sl_period[c] = p1
            sl_counter[c] = p1
            if p2 < 0 then sl_delta[c] = 0 - p2 else sl_delta[c] = p2 end
            c_target[c] = c_note[c]
            c_slide_delta[c] = diff
            if version >= 6 then sl_value[c] = prev_slide end
            if c_slide_delta[c] - sl_value[c] < 0 then sl_delta[c] = 0 - sl_delta[c] end
        elseif e == 3 then
            c_pos_s[c] = word(p1)
        elseif e == 4 then
            c_pos_o[c] = word(p1)
        elseif e == 5 then
            c_vib_counter[c] = p1
            c_vib_on[c] = p1
            c_vib_off[c] = p2
            sl_value[c] = 0
            sl_counter[c] = 0
        elseif e == 8 then
            sl_period[3] = p1
            sl_counter[3] = p1
            sl_delta[3] = p2
        end
        k += 1
    end
end

-- the registers of channel c for this frame: its envelope offset
function synth(byte c) -> long
    if not c_enabled[c] then
        regs[8 + c] = 0
        return 0
    end
    word s = c_sample[c]
    word slen_ = smp_len[s]
    word sloop = smp_loop[s]
    if slen_ == 0 then
        slen_ = 1
        sloop = 0
    end
    word li = c_pos_s[c]
    if li >= slen_ then li = sloop end
    byte b0 = smp_byte(s, li, 0)
    byte b1 = smp_byte(s, li, 1)
    long ltone = s16(long(smp_byte(s, li, 2)) | long(smp_byte(s, li, 3)) << 8)
    long level = b1 & 15
    long lvs = 0
    if b0 & 0x80 ~= 0 then
        if b0 & 0x40 ~= 0 then lvs = 1 else lvs = -1 end
    end
    long ne = (b0 >> 1) & 31
    if ne & 16 ~= 0 then ne -= 32 end
    bool env_mask = b0 & 1 ~= 0
    bool noise_mask = b1 & 0x80 ~= 0
    bool tone_mask = b1 & 0x10 ~= 0
    bool keep_tone = b1 & 0x40 ~= 0
    bool keep_ne = b1 & 0x20 ~= 0
    word o = c_orn[c]
    word olen = orn_len[o]
    word oloop = orn_loop[o]
    if olen == 0 then
        olen = 1
        oloop = 0
    end
    word oi_ = c_pos_o[c]
    if oi_ >= olen then oi_ = oloop end
    long orn_v = orn_at(o, oi_)
    long env_addon = 0
    long tone_add = ltone + c_tone_acc[c]
    if keep_tone then c_tone_acc[c] = tone_add end
    long half = c_prev[c] + orn_v
    long tn_v = (tone_of(half) + sl_value[c] + tone_add) & 0xFFF
    regs[c * 2] = byte(tn_v)
    regs[c * 2 + 1] = byte(tn_v >> 8)
    if tone_mask then regs[7] = regs[7] | (1 << c) end
    long vs = c_vol_slide[c] + lvs
    if vs < -15 then vs = -15 end
    if vs > 15 then vs = 15 end
    c_vol_slide[c] = vs
    long lv = vs + level
    if lv < 0 then lv = 0 end
    if lv > 15 then lv = 15 end
    byte v = voltab(word(c_volume[c] * 16 + lv))
    if c_env[c] and not env_mask then v = v | 16 end
    regs[8 + c] = v
    if noise_mask then
        long a = ne + c_env_sliding[c]
        if keep_ne then c_env_sliding[c] = a end
        env_addon = a
        regs[7] = regs[7] | (8 << c)
    else
        noise_addon = ne + c_noise_sliding[c]
        if keep_ne then c_noise_sliding[c] = noise_addon end
    end
    if sl_update(c) and c_target[c] ~= NO_TARGET then
        long d = sl_delta[c]
        long sv_ = sl_value[c]
        if (d < 0 and sv_ <= c_slide_delta[c]) or (d >= 0 and sv_ >= c_slide_delta[c]) then
            c_note[c] = c_target[c]
            c_prev[c] = c_target[c]
            c_target[c] = NO_TARGET
            sl_value[c] = 0
            sl_counter[c] = 0
        end
    end
    c_pos_s[c] += 1
    if c_pos_s[c] >= slen_ then c_pos_s[c] = sloop end
    c_pos_o[c] += 1
    if c_pos_o[c] >= olen then c_pos_o[c] = oloop end
    return env_addon
end

-- the stream: a frame against the previous one
byte prev[14]
long nframes = 0
long loop_frame = 0
long out_len = 0
long loop_off = 0

function emit_frame()
    bool full = nframes == loop_frame or nframes == 0
    if nframes == loop_frame then loop_off = out_len end
    word mask = 0
    for r = 0, 12 do
        if full or prev[r] ~= regs[r] then mask = mask | (1 << r) end
    end
    if env_write then mask = mask | (1 << 13) end
    ob(byte(mask))
    ob(byte(mask >> 8))
    out_len += 2
    for r = 0, 13 do
        if mask & (1 << r) ~= 0 then
            ob(regs[r])
            out_len += 1
        end
    end
    for r = 0, 13 do prev[r] = regs[r] end
    nframes += 1
end

function frame()
    regs[7] = 0
    long env_addon = 0
    for c = 0, 2 do
        env_addon += synth(c)
        if c_vib_counter[c] > 0 then
            c_vib_counter[c] -= 1
            if c_vib_counter[c] == 0 then
                c_enabled[c] = not c_enabled[c]
                if c_enabled[c] then c_vib_counter[c] = c_vib_on[c] else c_vib_counter[c] = c_vib_off[c] end
            end
        end
    end
    regs[6] = byte((noise_base + noise_addon) & 31)
    long env = env_addon + sl_value[3] + env_base
    regs[11] = byte(env)
    regs[12] = byte(env >> 8)
    sl_update(3)
    emit_frame()
    env_write = false
end

function head_is(string t) -> bool
    byte i = 0
    while i < len(t) do
        if i >= mlen or md[i] ~= asc(t, i) then return false end
        i += 1
    end
    return true
end

word positions[256]
word npos = 0

function do_pt3()
    long size = file_size(ai_fh)
    if size > 65535 then
        fail_m("the module is larger than 64K")
        return
    end
    mlen = word(size)
    word i = 0
    while i < mlen and not ai_bad do
        md[i] = ai_rd()
        i += 1
    end
    if mlen < 202 then
        fail_m("not a valid .pt3 module (too short)")
        return
    end
    if head_is("ProTracker 3.") and md[13] >= '0' and md[13] <= '9' then
        version = md[13] - '0'
    elseif head_is("ProTracker 3.") or head_is("Vortex Tracker II") then
        version = 6
    else
        fail_m("not a valid .pt3 module (no `ProTracker 3.` header)")
        return
    end
    byte t = md[99]
    if t == 1 then
        tsel = 1
    elseif t == 2 then
        if version <= 3 then tsel = 2 else tsel = 3 end
    elseif t == 3 then
        if version <= 3 then tsel = 4 else tsel = 5 end
    elseif t == 4 then
        tsel = 6
    elseif version <= 3 then
        tsel = 7
    else
        tsel = 8
    end
    vol35 = version > 4
    npos = 0
    word p = 201
    while p < mlen and md[p] ~= 0xFF and npos < 256 do
        positions[npos] = md[p] / 3
        npos += 1
        p += 1
    end
    if npos == 0 or 201 + npos >= mlen then
        fail_m("not a valid .pt3 module (no positions)")
        return
    end
    for k = 0, 31 do
        word so = le16(105 + k * 2)
        smp_off[k] = so
        smp_len[k] = 0
        smp_loop[k] = 0
        if so ~= 0 then
            if long(so) + 1 >= mlen then
                fail_m("not a valid .pt3 module (sample past the end)")
                return
            end
            word sz = md[so + 1]
            if sz ~= 0 then
                if long(so) + 2 + long(sz) * 4 > mlen then
                    fail_m("not a valid .pt3 module (sample past the end)")
                    return
                end
                smp_len[k] = sz
                word lp = md[so]
                if lp > sz - 1 then lp = sz - 1 end
                smp_loop[k] = lp
            end
        end
    end
    for k = 0, 15 do
        word oo = le16(169 + k * 2)
        orn_off[k] = oo
        orn_len[k] = 0
        orn_loop[k] = 0
        if oo ~= 0 then
            if long(oo) + 1 >= mlen then
                fail_m("not a valid .pt3 module (ornament past the end)")
                return
            end
            word sz = md[oo + 1]
            if long(oo) + 2 + sz > mlen then
                fail_m("not a valid .pt3 module (ornament past the end)")
                return
            end
            if sz ~= 0 then
                orn_len[k] = sz
                word lp = md[oo]
                if lp > sz - 1 then lp = sz - 1 end
                orn_loop[k] = lp
            end
        end
    end
    if failed then return end
    tempo = md[100]
    if tempo == 0 then tempo = 1 end
    for c = 0, 2 do
        c_ptr[c] = 0
        c_skip[c] = 1
        c_left[c] = 0
        c_enabled[c] = false
        c_env[c] = false
        c_note[c] = 0
        c_prev[c] = 0
        c_sample[c] = 1
        c_pos_s[c] = 0
        c_orn[c] = 0
        c_pos_o[c] = 0
        c_volume[c] = 15
        c_vol_slide[c] = 0
        c_target[c] = NO_TARGET
        c_slide_delta[c] = 0
        c_tone_acc[c] = 0
        c_env_sliding[c] = 0
        c_noise_sliding[c] = 0
        c_vib_counter[c] = 0
        c_vib_on[c] = 0
        c_vib_off[c] = 0
    end
    for k = 0, 3 do
        sl_period[k] = 0
        sl_counter[k] = 0
        sl_delta[k] = 0
        sl_value[k] = 0
    end
    for r = 0, 13 do
        regs[r] = 0
        prev[r] = 0
    end
    env_base = 0
    noise_base = 0
    noise_addon = 0
    env_write = false
    nframes = 0
    loop_frame = 0
    out_len = 0
    loop_off = 0
    word loop_pos = md[102]
    if loop_pos > npos - 1 then loop_pos = npos - 1 end
    word k = 0
    while k < npos and not failed do
        if k == loop_pos then loop_frame = nframes end
        start_pattern(positions[k])
        word row_n = 0
        while not failed do
            -- channel A's next cell starting with 0: the end of the pattern
            if c_left[0] == 0 and mb(c_ptr[0]) == 0 then break end
            if row_n == 0 then noise_base = 0 end
            for c = 0, 2 do
                if c_left[c] == 0 then
                    cell(c)
                    c_left[c] = c_skip[c]
                end
                c_left[c] -= 1
            end
            word tk = 0
            while tk < tempo do
                frame()
                tk += 1
            end
            row_n += 1
            if row_n > 256 or nframes > MAX_FRAMES then
                fail_m("not a valid .pt3 module (a pattern does not end)")
                return
            end
        end
        k += 1
    end
    if failed then return end
    if nframes == 0 then
        fail_m("not a valid .pt3 module (the song is empty)")
        return
    end
    ob(0)
    ob(0x80)
    out_len += 2
end

-- ---------------------------------------------------------------- main

-- the asset declarations of the program, from tokens.bin:
-- `asset NAME = "PATH"` and `asset NAME = image("PATH")`
const T_IDENT = 0
const T_INT = 1
const T_FIXED = 3
const T_STR = 4
const T_ASM_BODY = 5
const T_ASSET = 27
const T_ASSIGN = 47
const T_LPAREN = 57
const T_EOF = 66
const T_ERROR = 255
const MAXASSET = 64
string as_name[64]
string as_path[64]
byte as_img[64]
byte nas = 0

byte tkh = 255
byte tk_kind = 0
string tk_text = ""

function tin() -> byte
    word c = file_getc(tkh)
    if c == FILE_EOF then return T_EOF end
    return byte(c)
end

-- the next token: tk_kind, tk_text (identifiers and strings, at most 64)
function next_tok()
    tk_kind = tin()
    tin()
    tin()
    tin()
    tin()
    tk_text = ""
    if tk_kind == T_INT or tk_kind == T_FIXED then
        for k = 1, 4 do tin() end
    elseif tk_kind == T_IDENT or tk_kind == T_STR or tk_kind == T_ASM_BODY or tk_kind == T_ERROR then
        word n = tin()
        n = n | word(tin()) << 8
        word i = 0
        while i < n do
            byte b = tin()
            if i < 64 then tk_text = tk_text .. chr(b) end
            i += 1
        end
    end
end

function scan_assets()
    tkh = file_open("tokens.bin", FILE_READ)
    if tkh == FILE_ERROR then
        fail_m("cannot read tokens.bin")
        return
    end
    next_tok()
    while tk_kind ~= T_EOF and tk_kind ~= T_ERROR do
        if tk_kind == T_ASSET then
            next_tok()
            if tk_kind == T_IDENT then
                string nm = tk_text
                next_tok()
                if tk_kind == T_ASSIGN then
                    next_tok()
                    byte img = 0
                    if tk_kind == T_IDENT and tk_text == "image" then
                        next_tok()
                        if tk_kind == T_LPAREN then next_tok() end
                        img = 1
                    end
                    if tk_kind == T_STR and nas < MAXASSET then
                        as_name[nas] = nm
                        as_path[nas] = tk_text
                        as_img[nas] = img
                        nas += 1
                    end
                end
            end
        end
        next_tok()
    end
    file_close(tkh)
end

-- the lower-case extension of p is e?
function ext_of(string p, string e) -> bool
    byte n = len(p)
    byte k = len(e)
    if n <= k or asc(p, n - k - 1) ~= '.' then return false end
    byte i = 0
    while i < k do
        byte c = asc(p, n - k + i)
        if c >= 'A' and c <= 'Z' then c += 32 end
        if c ~= asc(e, i) then return false end
        i += 1
    end
    return true
end

function write_inf(string name)
    if not out_open("a_" .. name .. ".inf") then return end
    for k = 0, 3 do ob(byte(out_len >> (k * 8))) end
    for k = 0, 3 do ob(byte(loop_off >> (k * 8))) end
    out_close()
end

function convert(byte a)
    string name = as_name[a]
    string path = as_path[a]
    byte kind = 0
    if as_img[a] ~= 0 then
        kind = 'i'
    elseif ext_of(path, "png") then
        kind = 'p'
    elseif ext_of(path, "wav") then
        kind = 'w'
    elseif ext_of(path, "pt3") then
        kind = 'm'
    else
        return                  -- taken as it is
    end
    err_path = path
    -- a file that cannot be read: the code generator reports it (with
    -- the position of the declaration)
    if not ai_open(path) then return end
    if not out_open("a_" .. name .. ".bin") then
        ai_close()
        return
    end
    if kind == 'w' then
        do_wav()
    elseif kind == 'm' then
        do_pt3()
    else
        do_png(kind)
    end
    if ai_bad then fail_m(ai_err) end
    out_close()
    ai_close()
    if failed then return end
    if kind == 'i' then
        if not out_open("a_" .. name .. ".msk") then return end
        if masked then ob(1) else ob(0) end
        out_close()
    end
    if kind == 'm' then write_inf(name) end
end

scan_assets()
word count = 0
byte ia = 0
while ia < nas and not failed do
    convert(ia)
    ia += 1
    count += 1
end
if failed then
    byte eh = file_open("assets.err", FILE_WRITE)
    string m = "error " .. err_path .. ": " .. err_text
    print(m)
    if eh ~= FILE_ERROR then
        file_write(eh, addr(m) + 1, len(m))
        file_close(eh)
    end
else
    print("assets:", count, "converted")
    if file_exists("chain.on") then
        if not file_exec("nexload codegen.nex") then print("cannot start codegen.nex, error", file_status) end
    end
end
