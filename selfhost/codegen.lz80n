-- selfhost/codegen.lz80n - the LZ80N code generator, written in LZ80N
--
-- Reads tokens.bin (lexer.lz80n), parses it (parser_core.lz80n) and writes
-- the Z80N assembly of the program to out.asm, ready for asm.lz80n. The
-- runtime library comes from files on the SD card - the texts of
-- compiler/src/runtime.rs and font.rs: rt_start.asm (startup code),
-- rt_lib.asm (runtime routines), rt_long.asm (32-bit routines),
-- rt_banked.asm (banked calls), rt_font.asm (text font). On an error
-- codegen.err holds `error LINE:COL message`.
--
-- It is not a copy of compiler/src/codegen.rs: it makes simpler code (no
-- optimisation), but the same labels (g_ p_ l_ f_ s_), the same calling
-- convention and the same runtime, so `asm` blocks and the standard modules
-- work unchanged. The tests run programs compiled both ways in the emulator
-- and compare what they print.
--
-- Values: 8/16-bit in HL, 32-bit (long) in DE:HL, strings as an address
-- in HL (length byte + up to 64 characters). An expression is evaluated at
-- a width (1, 2 or 4 bytes) and a signedness: the wider of its own type and
-- the destination's. A 1-byte result is kept extended in HL (H = 0, or the
-- sign of L).
--
-- Supported: bool, byte, sbyte, word, sword, long, string; constants;
-- globals, locals, parameters; one-dimensional arrays, far arrays; all
-- integer operators, `..`, string comparisons; casts; if, while, for,
-- break, return; functions and recursion; print, write, len, asc, chr, str,
-- addr, memory[], port[], nextreg[], asm, the built-ins of the second
-- graphics layer (pixels, horizontal lines, clear, flip, mode, size), abs min
-- max, vsync pause cls at ink border key kempston any_key wait_key frames
-- random seed; code banking (functions move into 8K pages when the
-- resident area would overflow). Not yet: fixed, fixed16, structs, classes,
-- multi-dimensional arrays, assets, interrupts, functions returning
-- strings, the other built-in functions; the standard modules that need
-- classes (the hardware-object module) or other missing parts.
--
-- Recursion: parameters and locals have fixed addresses (static frames, as
-- in codegen.rs). A call that can lead back to the calling function (found
-- in the call graph) copies the caller's frame - the block fr_NAME ..
-- fr_NAME_end - to the stack before the call and back after it.

include "parser_core.lz80n"
include "asset_info.lz80n"

-- ---------------------------------------------------------------- output

byte outh                   -- out.asm
byte bankh                  -- bank.asm (banked functions)
byte cur_h                  -- where ob() writes
byte obuf[256]
word olen = 0
word lines_out = 0          -- newlines written
long cost_out = 0           -- estimated bytes of the instructions written
byte lcur[40]               -- the start of the line being written
byte lcn = 0

function flush()
    if olen > 0 then
        file_write(cur_h, addr(obuf), olen)
        olen = 0
    end
end

function to_file(byte h)
    flush()
    cur_h = h
end

function ob(byte b)
    obuf[olen] = b
    olen += 1
    if b == 10 then
        lines_out += 1
        cost_out += line_cost()
        lcn = 0
    elseif lcn < 40 then
        lcur[lcn] = b
        lcn += 1
    end
    if olen == 256 then flush() end
end

-- does the line start (after its 4 spaces) with s?
function lis(string s) -> bool
    byte n = len(s)
    if lcn < n + 4 then return false end
    byte i = 0
    while i < n do
        if lcur[4 + i] ~= asc(s, i) then return false end
        i += 1
    end
    return true
end

-- is character i of the line one of a b c d e h l (a register)?
function lreg(byte i) -> bool
    if i >= lcn then return false end
    byte c = lcur[i]
    return c == 'a' or c == 'b' or c == 'c' or c == 'd' or c == 'e' or c == 'h' or c == 'l'
end

-- does the line contain c?
function lhas(byte c) -> bool
    byte i = 0
    while i < lcn do
        if lcur[i] == c then return true end
        i += 1
    end
    return false
end

-- estimated bytes of the instruction in lcur (0 for labels and comments)
function line_cost() -> byte
    if lcn < 5 or lcur[0] ~= ' ' then return 0 end
    byte i = 0
    while i < lcn and (lcur[i] == ' ' or lcur[i] == 9) do i += 1 end
    if i >= lcn or lcur[i] == ';' then return 0 end
    if lis("ld ") then
        if lhas('x') or lhas('y') then return 4 end         -- ix / iy
        if lis("ld (hl)") or lis("ld a,(hl)") or lis("ld a,(de)") or lis("ld a,(bc)") or lis("ld (de)") or lis("ld (bc)") then return 1 end
        if lis("ld e,(hl)") or lis("ld d,(hl)") or lis("ld h,(hl)") or lis("ld l,(hl)") then return 1 end
        if lis("ld de,(") or lis("ld bc,(") or lis("ld sp,(") then return 4 end
        if lhas('(') then
            if lis("ld (") and (lcur[lcn - 2] == 'd' or lcur[lcn - 2] == 'b' or lcur[lcn - 2] == 's') then return 4 end
            return 3
        end
        if lis("ld hl,") or lis("ld de,") or lis("ld bc,") or lis("ld sp,") then
            if lis("ld sp,hl") then return 1 end
            return 3
        end
        -- ld r,r' or ld r,n
        if lcn == 10 and lreg(7) and lreg(9) then return 1 end
        if lis("ld a,i") or lis("ld i,a") then return 2 end
        return 2
    end
    if lis("call ") or lis("jp ") then
        if lis("jp (") then return 1 end
        return 3
    end
    if lis("jr ") or lis("djnz ") then return 2 end
    if lis("add hl,") or lis("add a,") then
        if lis("add a,") and not lreg(10) then return 2 end
        return 1
    end
    if lis("sbc hl") or lis("adc hl") or lis("ldir") or lis("lddr") or lis("ldi") or lis("neg") or lis("reti") or lis("im ") or lis("mul") then return 2 end
    if lis("sra") or lis("srl") or lis("sla") or lis("rr ") or lis("rl ") or lis("rlc ") or lis("rrc ") or lis("bit ") or lis("set ") or lis("res ") then return 2 end
    if lis("nextreg") then return 4 end
    if lis("and ") or lis("or ") or lis("xor ") or lis("cp ") or lis("sub ") or lis("sbc a,") then
        -- a register (or (hl)) operand is one byte
        byte j = lcn - 1
        if lreg(j) and (lcur[j - 1] == ' ' or lcur[j - 1] == ',') then return 1 end
        if lcur[j] == ')' then return 1 end
        return 2
    end
    if lis("out (") or lis("in a,(") then
        if lhas('c') and lis("out (c)") then return 2 end
        if lis("in a,(c)") then return 2 end
        return 2
    end
    if lis("db ") or lis("dw ") or lis("dd ") then
        -- the line may be longer than lcur: a rough count
        byte n = 1
        byte k = 0
        while k < lcn do
            if lcur[k] == ',' then n += 1 end
            k += 1
        end
        if lcn == 40 then n = n * 2 + 8 end
        if lis("dw ") then return n * 2 end
        if lis("dd ") then return n * 4 end
        return n
    end
    if lis("ds ") then return 64 end
    if lis("rst") or lis("push") or lis("pop") or lis("ex ") or lis("exx") or lis("inc") or lis("dec") or lis("ret") or lis("rla") or lis("rra") or lis("rlca") or lis("rrca") or lis("cpl") or lis("scf") or lis("ccf") or lis("di") or lis("ei") or lis("halt") or lis("nop") then return 1 end
    return 4
end

function os(string s)
    byte n = len(s)
    byte i = 0
    while i < n do
        ob(asc(s, i))
        i += 1
    end
end

function onl()
    ob(10)
end

-- an instruction line
function oi(string s)
    os("    ")
    os(s)
    onl()
end

function otok(word t)
    word i = 0
    word o = toff[t]
    while i < tlen[t] do
        ob(tpool[o + i])
        i += 1
    end
end

function odec(word v)
    dec32(0, v)
    while ndig > 0 do
        ndig -= 1
        ob(digits[ndig])
    end
end

-- copy a file from the SD card into the output
function ocopy(string name)
    byte h = file_open(name, FILE_READ)
    if h == FILE_ERROR then
        if fail_at(0, 0) then
            msg("cannot open ")
            msg(name)
        end
        return
    end
    word c = file_getc(h)
    while c ~= FILE_EOF do
        ob(byte(c))
        c = file_getc(h)
    end
    file_close(h)
end

-- ---------------------------------------------------------------- errors

function fail_node(word n) -> bool
    return fail_at(nl[n], nc[n])
end

function unsupported(word n, string what)
    if fail_node(n) then
        msg("not supported by the self-hosted compiler yet: ")
        msg(what)
    end
end

-- ---------------------------------------------------------------- types

const TY_NONE = 0           -- an untyped constant
const TY_BOOL = 1
const TY_BYTE = 2
const TY_SBYTE = 3
const TY_WORD = 4
const TY_SWORD = 5
const TY_LONG = 6
const TY_STR = 9
const TY_STRUCT = 16        -- struct number k: TY_STRUCT + k
const TY_BAD = 255

function tsize(byte t) -> byte
    if t == TY_LONG then return 4 end
    if t >= TY_WORD and t <= TY_SWORD then return 2 end
    return 1
end

function tsigned(byte t) -> bool
    return t == TY_SBYTE or t == TY_SWORD or t == TY_LONG
end

-- bytes of storage
function tstore(byte t) -> word
    if t == TY_STR then return 65 end
    if is_struct(t) then return tabw[W_ST_SIZE + (t - TY_STRUCT)] end
    return tsize(t)
end

function make_ty(byte size, bool sg) -> byte
    if size == 4 then return TY_LONG end
    if size == 2 then
        if sg then return TY_SWORD end
        return TY_WORD
    end
    if sg then return TY_SBYTE end
    return TY_BYTE
end

function join(byte a, byte b) -> byte
    if a == TY_NONE then return b end
    if b == TY_NONE then return a end
    if a == TY_STR or b == TY_STR then return TY_STR end
    if a == TY_BOOL and b == TY_BOOL then return TY_BOOL end
    byte sz = tsize(a)
    if tsize(b) > sz then sz = tsize(b) end
    return make_ty(sz, tsigned(a) or tsigned(b))
end

-- ---------------------------------------------------------------- structs

-- small tables, packed into two far arrays (each far array takes whole 8K pages)
const W_ST_NAME = 0
const W_ST_SIZE = 200
const W_ST_FF = 400
const W_ST_NF = 600
const W_ST_INIT = 800
const W_FD_NAME = 1000
const W_FD_LEN = 3000
const W_FD_OFF = 5000
const W_FD_DEFL = 7000
const W_FD_DEFH = 9000
const W_AS_NAME = 11000
const W_AS_PATH = 11064
const W_AS_W = 11128
const W_AS_H = 11192
const W_AS_LENL = 11256
const W_AS_LENH = 11320
const W_AS_N = 11384
const B_ST_PARENT = 0
const B_FD_TY = 200
const B_FD_HASDEF = 2200
const B_AS_KIND = 4200
const B_AS_PAGE = 4264
const B_AS_NP = 4328
const B_AS_RPP = 4392
const B_AS_PRESC = 4456
const B_PASSET = 4520
far word tabw[11448]
far byte tabb[4776]

const MAXSTRUCT = 200
byte nstructs = 0
const MAXFIELD = 2000
word nfields = 0

function is_struct(byte t) -> bool
    return t >= TY_STRUCT and t < TY_BAD
end

-- the struct named by token t, 255 if there is none
function struct_by_name(word t) -> byte
    if tk[t] ~= T_IDENT then return 255 end
    byte k = 0
    while k < nstructs do
        if toff[tabw[W_ST_NAME + k]] == toff[t] then return k end
        k += 1
    end
    return 255
end

-- the field `name` of struct k, 0 if there is none
function field_find(byte k, word name) -> word
    word f = tabw[W_ST_FF + k]
    word n = 0
    while n < tabw[W_ST_NF + k] do
        if toff[tabw[W_FD_NAME + (f + n)]] == toff[name] then return f + n end
        n += 1
    end
    return 0
end

-- does struct k (or a struct inside it) have field defaults?
function has_defaults(byte k) -> bool
    word f = tabw[W_ST_FF + k]
    word n = 0
    while n < tabw[W_ST_NF + k] do
        word x = f + n
        if tabb[B_FD_HASDEF + x] ~= 0 then return true end
        if is_struct(tabb[B_FD_TY + x]) and has_defaults(tabb[B_FD_TY + x] - TY_STRUCT) then return true end
        n += 1
    end
    return false
end

-- type of a type-name token, TY_BAD if it is none (or not supported)
function type_of(word t) -> byte
    if text_is(t, "bool") then return TY_BOOL end
    if text_is(t, "byte") then return TY_BYTE end
    if text_is(t, "sbyte") then return TY_SBYTE end
    if text_is(t, "word") then return TY_WORD end
    if text_is(t, "sword") then return TY_SWORD end
    if text_is(t, "long") then return TY_LONG end
    if text_is(t, "string") then return TY_STR end
    byte k = struct_by_name(t)
    if k ~= 255 then return TY_STRUCT + k end
    return TY_BAD
end

function lit_ty(long v) -> byte
    if v >= 0 and v <= 255 then return TY_BYTE end
    if v >= -128 and v < 0 then return TY_SBYTE end
    if v >= 0 and v <= 65535 then return TY_WORD end
    if v >= -32768 and v < 0 then return TY_SWORD end
    return TY_LONG
end

bool uses_long = false

-- ---------------------------------------------------------------- symbols

const SK_GLOBAL = 1
const SK_PARAM = 2
const SK_LOCAL = 3
const SK_CONST = 4
const SK_FUNC = 5
const SK_ASSET = 6          -- sid: the asset number

const MAXSY = 8000
far byte sk[8000]           -- kind
far byte sty[8000]          -- type (function: return type, TY_NONE = none)
far word sname[8000]        -- name token (0: a hidden temporary)
far word sown[8000]         -- params / locals: the function symbol (0 = main)
far word sid[8000]          -- locals: number; constants: value (low word)
far word sv2[8000]          -- constants: value (high word); functions: node;
                            -- global arrays: initializer list
far word slen[8000]         -- arrays: element count (0 = scalar)
far byte sdead[8000]        -- out of scope
far byte snp[8000]          -- functions: number of parameters
far byte spage[8000]        -- far arrays: first 8K page (0 = not far)
far byte sbank[8000]        -- functions: code page (0 = resident)
far byte sstruct[8000]      -- methods: struct number + 1 (0 = a plain function)
far word snext[8000]        -- the previous symbol with the same name hash
far word shead[1024]        -- name hash -> the newest symbol
word nsy = 0
long resident_used = 0      -- estimated bytes of code and data so far (resident)
word nlocal = 0             -- numbers for local labels
word cur_fn = 0             -- function being compiled (0 = main program)

-- identifiers are interned (parser_core): equal names, equal offsets
function name_hash(word t) -> word
    return toff[t] & 1023
end

-- a visible local or parameter first, then a global, constant or function
function lookup(word t) -> word
    word o = toff[t]
    word s = shead[o & 1023]
    word other = 0
    while s ~= 0 do
        if sdead[s] == 0 and toff[sname[s]] == o then
            byte k = sk[s]
            if k == SK_LOCAL or k == SK_PARAM then return s end
            if other == 0 and not (k == SK_FUNC and sstruct[s] ~= 0) then other = s end
        end
        s = snext[s]
    end
    return other
end

-- the method `name` of struct k or of its parents, 0 if there is none
function method_find(byte k, word name) -> word
    while k ~= 255 do
        word s = shead[toff[name] & 1023]
        while s ~= 0 do
            if sk[s] == SK_FUNC and sstruct[s] == k + 1 and toff[sname[s]] == toff[name] then return s end
            s = snext[s]
        end
        k = tabb[B_ST_PARENT + k]
    end
    return 0
end

-- `self` inside a method
function is_self(word t) -> bool
    return cur_fn ~= 0 and sstruct[cur_fn] ~= 0 and text_is(t, "self")
end

-- a parameter holding an address (strings and structs are passed by reference)
function is_ref_param(word s) -> bool
    return sk[s] == SK_PARAM and (sty[s] == TY_STR or is_struct(sty[s]))
end

function new_sym(byte kind, word name, byte ty) -> word
    if nsy >= MAXSY - 1 then
        if fail_at(0, 0) then msg("too many symbols") end
        return 0
    end
    nsy += 1
    word s = nsy
    sk[s] = kind
    sname[s] = name
    sty[s] = ty
    sown[s] = cur_fn
    sdead[s] = 0
    slen[s] = 0
    sid[s] = 0
    sv2[s] = 0
    spage[s] = 0
    sbank[s] = 0
    sstruct[s] = 0
    if name ~= 0 then
        word h = name_hash(name)
        snext[s] = shead[h]
        shead[h] = s
    end
    if ty == TY_LONG then uses_long = true end
    return s
end

-- a new local of the current function (hidden when name = 0); its storage
-- counts in the resident area
function new_local(word name, byte ty) -> word
    word v = new_sym(SK_LOCAL, name, ty)
    nlocal += 1
    sid[v] = nlocal
    return v
end

-- a hidden temporary string of the current function
function temp_str() -> word
    word t = new_local(0, TY_STR)
    sdead[t] = 1
    return t
end

-- the name part of function f's labels: `name`, or `Struct_name` for a method
function o_fnname(word f)
    if sstruct[f] ~= 0 then
        otok(tabw[W_ST_NAME + (sstruct[f] - 1)])
        ob('_')
    end
    otok(sname[f])
end

-- the label of symbol s
function olab(word s)
    byte k = sk[s]
    if k == SK_GLOBAL then
        os("g_")
        otok(sname[s])
    elseif k == SK_FUNC then
        if sstruct[s] ~= 0 then os("m_") else os("f_") end
        o_fnname(s)
    elseif k == SK_PARAM then
        os("p_")
        o_fnname(sown[s])
        ob('_')
        if sname[s] == 0 then os("self") else otok(sname[s]) end
    else
        os("l_")
        if sown[s] == 0 then os("main") else o_fnname(sown[s]) end
        ob('_')
        if sname[s] == 0 then os("_t") else otok(sname[s]) end
        ob('_')
        odec(sid[s])
    end
end

function const_value(word s) -> long
    return long(sv2[s]) << 16 | long(sid[s])
end

-- ---------------------------------------------------------------- labels

word nlabel = 0

function new_label() -> word
    nlabel += 1
    return nlabel
end

function oL(word n)
    os("__L")
    odec(n)
end

function label(word n)
    oL(n)
    ob(':')
    onl()
end

function jp(string how, word n)
    os("    ")
    os(how)
    oL(n)
    onl()
end

-- string literals: zero-terminated s_N (print) and length-prefixed ps_N (values)
const MAXSTR = 3000
far word strs[3000]
word nstrs = 0
far word pstrs[3000]
word npstrs = 0

function str_label(word tok) -> word
    if nstrs >= MAXSTR then
        if fail_tok(tok) then msg("too many string literals") end
        return 0
    end
    strs[nstrs] = tok
    nstrs += 1
    return nstrs - 1
end

function pstr_label(word tok) -> word
    if npstrs >= MAXSTR then
        if fail_tok(tok) then msg("too many string literals") end
        return 0
    end
    pstrs[npstrs] = tok
    npstrs += 1
    return npstrs - 1
end

-- ---------------------------------------------------------------- constants

long cv                     -- result of const_eval

function lit_val(word n) -> long
    word t = n1[n]
    long v = long(tvh[t]) << 16 | long(tvl[t])
    if nf[n] ~= 0 then v = 0 - v end
    return v
end

-- the compile-time value of e (in cv), false if it has none
function const_eval(word e) -> bool
    byte k = nk[e]
    if k == E_INT then
        cv = lit_val(e)
        return true
    end
    if k == E_BOOL then
        cv = nf[e]
        return true
    end
    if k == E_NAME then
        word s = lookup(n1[e])
        if s ~= 0 and sk[s] == SK_CONST then
            cv = const_value(s)
            return true
        end
        return false
    end
    if k == E_UNARY then
        if not const_eval(n1[e]) then return false end
        if nf[e] == 0 then
            cv = 0 - cv
        elseif nf[e] == 2 then
            cv = ~cv
        else
            return false
        end
        return true
    end
    if k == E_CALL then
        word a = n2[e]
        if (text_is(n1[e], "image_width") or text_is(n1[e], "image_height")) and a ~= 0 and nx[a] == 0 then
            byte im = asset_arg(a, AK_IMG)
            if im == 255 then return false end
            if text_is(n1[e], "image_width") then cv = tabw[W_AS_W + im] else cv = tabw[W_AS_H + im] end
            return true
        end
        bool is_abs = text_is(n1[e], "abs")
        bool is_min = text_is(n1[e], "min")
        if not is_abs and not is_min and not text_is(n1[e], "max") then return false end
        if a == 0 or not const_eval(a) then return false end
        long x = cv
        if is_abs then
            if nx[a] ~= 0 then return false end
            if x < 0 then cv = 0 - x end
            return true
        end
        if nx[a] == 0 or nx[nx[a]] ~= 0 or not const_eval(nx[a]) then return false end
        if (is_min and x < cv) or (not is_min and x > cv) then cv = x end
        return true
    end
    if k == E_BINARY then
        byte op = nf[e]
        if op > B_SHR or op == B_CONCAT then return false end
        if not const_eval(n1[e]) then return false end
        long a = cv
        if not const_eval(n2[e]) then return false end
        long b = cv
        if op == B_ADD then
            cv = a + b
        elseif op == B_SUB then
            cv = a - b
        elseif op == B_MUL then
            cv = a * b
        elseif op == B_DIV then
            if b == 0 then return false end
            cv = a / b
        elseif op == B_MOD then
            if b == 0 then return false end
            cv = a % b
        elseif op == B_AND then
            cv = a & b
        elseif op == B_OR then
            cv = a | b
        elseif op == B_XOR then
            cv = a ~ b
        elseif op == B_SHL then
            cv = a << byte(b & 31)
        else
            cv = a >> byte(b & 31)
        end
        return true
    end
    return false
end

-- ---------------------------------------------------------------- types of expressions

function is_cast(word t) -> byte
    byte ty = type_of(t)
    if ty == TY_BOOL or ty == TY_STR then return TY_BAD end
    return ty
end

-- the natural type of e
function nat(word e) -> byte
    byte k = nk[e]
    if k == E_INT then return TY_NONE end
    if k == E_BOOL then return TY_BOOL end
    if k == E_STR then return TY_STR end
    if k == E_NAME then
        if is_self(n1[e]) then return TY_STRUCT + sstruct[cur_fn] - 1 end
        word s = lookup(n1[e])
        if s == 0 or sk[s] == SK_CONST or sk[s] == SK_ASSET then return TY_NONE end
        return sty[s]
    end
    if k == E_INDEX then
        if is_hw(e) ~= 0 then return TY_BYTE end
        if place_type(e) then return pt_ty end
        return TY_NONE
    end
    if k == E_FIELD then
        if place_type(e) then return pt_ty end
        return TY_NONE
    end
    if k == E_METHOD then
        word f = resolve_method(e)
        if f == 0 then return TY_NONE end
        return sty[f]
    end
    if k == E_UNARY then
        if nf[e] == 1 then return TY_BOOL end
        return nat(n1[e])
    end
    if k == E_BINARY then
        byte op = nf[e]
        if op >= B_EQ then return TY_BOOL end
        if op == B_CONCAT then return TY_STR end
        return join(nat(n1[e]), nat(n2[e]))
    end
    if k == E_CALL then
        word name = n1[e]
        byte c = is_cast(name)
        if c ~= TY_BAD then return c end
        if (text_is(name, "abs") or text_is(name, "min") or text_is(name, "max")) and const_eval(e) then return TY_NONE end
        if text_is(name, "chr") or text_is(name, "str") then return TY_STR end
        if text_is(name, "len") or text_is(name, "asc") then return TY_BYTE end
        if text_is(name, "addr") or text_is(name, "image_width") or text_is(name, "image_height") then return TY_WORD end
        if text_is(name, "sample_playing") then return TY_BOOL end
        if text_is(name, "note_period") then return TY_WORD end
        word s = lookup(name)
        if s ~= 0 and sk[s] == SK_FUNC then return sty[s] end
        byte sk_ = struct_by_name(name)
        if sk_ ~= 255 and s == 0 then return TY_STRUCT + sk_ end
        if text_isx(name, "p|oint") or text_is(name, "kempston") then return TY_BYTE end
        if text_isx(name, "l|ayer2_width") or text_isx(name, "l|ayer2_height") or text_is(name, "frames") or text_is(name, "random") then return TY_WORD end
        if text_is(name, "key") or text_is(name, "any_key") then return TY_BOOL end
        if text_is(name, "abs") then return nat(n2[e]) end
        if text_is(name, "min") or text_is(name, "max") then
            word a = n2[e]
            if a == 0 or nx[a] == 0 then return TY_NONE end
            return join(nat(a), nat(nx[a]))
        end
        return TY_NONE
    end
    return TY_NONE
end

-- the type an expression is computed at for a destination of type d
function ctx_ty(byte d, word e) -> byte
    byte t = join(d, nat(e))
    if t == TY_NONE then
        if const_eval(e) then return lit_ty(cv) end
        return TY_WORD
    end
    if t == TY_BOOL then return TY_BYTE end
    return t
end

-- ---------------------------------------------------------------- code: values

-- keep a 1-byte result extended in HL
function fix(byte w, bool sg)
    if w ~= 1 then return end
    if sg then
        oi("ld a,l")
        oi("rla")
        oi("sbc a,a")
        oi("ld h,a")
    else
        oi("ld h,0")
    end
end

-- HL (16-bit, signed or not) -> DE:HL
function extend32(bool sg)
    if sg then
        oi("ld a,h")
        oi("rla")
        oi("sbc a,a")
        oi("ld e,a")
        oi("ld d,a")
    else
        oi("ld de,0")
    end
end

function load_const(long v, byte w, bool sg)
    if w == 4 then
        os("    ld hl,")
        odec(word(v))
        onl()
        os("    ld de,")
        odec(word(v >> 16))
        onl()
        return
    end
    word x = word(v)
    if w == 1 then
        x = x & 255
        if sg and x >= 128 then x = x | 0xFF00 end
    end
    os("    ld hl,")
    odec(x)
    onl()
end

-- A (loaded) -> HL, extended by the type t
function extend_a(byte t)
    oi("ld l,a")
    if tsigned(t) then
        oi("rla")
        oi("sbc a,a")
        oi("ld h,a")
    else
        oi("ld h,0")
    end
end

function o_ins_lab(string ins, word s, string tail)
    os("    ")
    os(ins)
    olab(s)
    os(tail)
    onl()
end

-- load symbol s into HL (DE:HL for long)
function load_sym(word s)
    byte t = sty[s]
    if tsize(t) == 1 then
        o_ins_lab("ld a,(", s, ")")
        extend_a(t)
    elseif tsize(t) == 2 then
        o_ins_lab("ld hl,(", s, ")")
    else
        o_ins_lab("ld hl,(", s, ")")
        o_ins_lab("ld de,(", s, "+2)")
    end
end

-- store HL (DE:HL) into symbol s; a string parameter takes an address
function store_sym(word s)
    byte t = sty[s]
    if t == TY_STR or is_struct(t) then
        o_ins_lab("ld (", s, "),hl")
    elseif tsize(t) == 1 then
        oi("ld a,l")
        o_ins_lab("ld (", s, "),a")
    elseif tsize(t) == 2 then
        o_ins_lab("ld (", s, "),hl")
    else
        o_ins_lab("ld (", s, "),hl")
        o_ins_lab("ld (", s, "+2),de")
    end
end

-- store the value pushed by push_val (type t) at the address in HL
function store_at_hl(byte t)
    oi("pop de")
    oi("ld (hl),e")
    if tsize(t) >= 2 then
        oi("inc hl")
        oi("ld (hl),d")
    end
    if tsize(t) == 4 then
        oi("inc hl")
        oi("pop de")
        oi("ld (hl),e")
        oi("inc hl")
        oi("ld (hl),d")
    end
end

-- push the value of type t (HL / DE:HL)
function push_val(byte t)
    if tsize(t) == 4 then oi("push de") end
    oi("push hl")
end

-- a variable (not a constant, not a function) named by token t
function var_sym(word n, word t) -> word
    word s = lookup(t)
    if s == 0 then
        if fail_node(n) then
            msg("undefined variable `")
            msg_text(t)
            msg("`")
        end
        return 0
    end
    if sk[s] == SK_FUNC then
        if fail_node(n) then msg("a function is not a value") end
        return 0
    end
    if sk[s] == SK_ASSET then
        if fail_node(n) then
            msg("`")
            msg_text(t)
            msg("` is an asset (use it with `s")
            msg("prite_load`)")
        end
        return 0
    end
    return s
end

-- is token t the word s, ignoring `|` in s? (the `|` keeps the names of
-- library functions out of this source, which would otherwise pull their
-- modules into itself)
function text_isx(word t, string s)-> bool
    byte n = len(s)
    if tk[t] ~= T_IDENT then return false end
    word o = toff[t]
    word j = 0
    byte i = 0
    while i < n do
        byte c = asc(s, i)
        if c ~= '|' then
            if j >= tlen[t] or tpool[o + j] ~= c then return false end
            j += 1
        end
        i += 1
    end
    return j == tlen[t]
end

-- memory[] 1, port[] 2, nextreg[] 3, else 0
function is_hw(word e) -> byte
    word base = n1[e]
    if nk[base] ~= E_NAME then return 0 end
    word t = n1[base]
    if lookup(t) ~= 0 then return 0 end
    if text_is(t, "memory") then return 1 end
    if text_is(t, "port") then return 2 end
    if text_is(t, "nextreg") then return 3 end
    return 0
end

-- port[n] / nextreg[n] -> HL (a byte)
function gen_hw_read(word e, byte hw)
    gen(n2[e], 2, false)
    if hw == 2 then
        oi("ld b,h")
        oi("ld c,l")
        oi("in a,(c)")
    else
        oi("ld a,l")
        oi("ld bc,$243B")
        oi("out (c),a")
        oi("inc b")
        oi("in a,(c)")
    end
    extend_a(TY_BYTE)
end

-- port[n] = value / nextreg[n] = value (op: compound assignment - 1, or 255)
function gen_hw_write(word target, word value, byte hw, byte op)
    if op ~= 255 then
        gen_op_assign(op, target, value, TY_BYTE)
    else
        gen_for(value, TY_BYTE)
    end
    word idx = n2[target]
    if hw == 3 and const_eval(idx) then
        oi("ld a,l")
        os("    nextreg ")
        odec(word(cv) & 255)
        os(",a")
        onl()
        return
    end
    oi("push hl")
    gen(idx, 2, false)
    if hw == 2 then
        oi("ld b,h")
        oi("ld c,l")
    else
        oi("ld a,l")
        oi("ld bc,$243B")
        oi("out (c),a")
        oi("inc b")
    end
    oi("pop hl")
    oi("ld a,l")
    oi("out (c),a")
end


-- A far element is mapped into MMU slot 1 last (after the index).
-- what gen_place would give, without code: pt_ty, pt_len (array: count)
byte pt_ty
word pt_len
function place_type(word e) -> bool
    byte k = nk[e]
    if k == E_NAME then
        if is_self(n1[e]) then
            pt_ty = TY_STRUCT + sstruct[cur_fn] - 1
            pt_len = 0
            return true
        end
        word s = lookup(n1[e])
        if s == 0 or sk[s] == SK_CONST or sk[s] == SK_FUNC or sk[s] == SK_ASSET then return false end
        pt_ty = sty[s]
        pt_len = slen[s]
        return true
    end
    if k == E_INDEX then
        if is_hw(e) ~= 0 then
            pt_ty = TY_BYTE
            pt_len = 0
            return true
        end
        if not place_type(n1[e]) or pt_len == 0 then return false end
        pt_len = 0
        return true
    end
    if k == E_FIELD then
        if not place_type(n1[e]) or not is_struct(pt_ty) or pt_len ~= 0 then return false end
        word f = field_find(pt_ty - TY_STRUCT, n2[e])
        if f == 0 then return false end
        pt_ty = tabb[B_FD_TY + f]
        pt_len = tabw[W_FD_LEN + f]
        return true
    end
    if k == E_CALL or k == E_METHOD then
        byte t = nat(e)
        if is_struct(t) then
            pt_ty = t
            pt_len = 0
            return true
        end
    end
    return false
end

-- HL = element index * size of t
function scale(byte t)
    word sz = tstore(t)
    if sz == 1 then return end
    if sz == 2 then
        oi("add hl,hl")
    elseif sz == 4 then
        oi("add hl,hl")
        oi("add hl,hl")
    else
        os("    ld de,")
        odec(sz)
        onl()
        oi("call rt_mul16")
    end
end

-- the address of a variable, element or field in HL; its type in pl_ty,
-- its element count in pl_len (0 = not an array). A far element is mapped
-- into MMU slot 1 last.
byte pl_ty
word pl_len
function gen_place(word e)
    if failed then return end
    byte k = nk[e]
    if k == E_NAME then
        if is_self(n1[e]) then
            o_ins_lab("ld hl,(", cur_fn + 1, ")")
            pl_ty = TY_STRUCT + sstruct[cur_fn] - 1
            pl_len = 0
            return
        end
        word s = var_sym(e, n1[e])
        if s == 0 then return end
        if sk[s] == SK_CONST or spage[s] ~= 0 then
            if fail_node(e) then msg("this has no address") end
            return
        end
        pl_ty = sty[s]
        pl_len = slen[s]
        if is_ref_param(s) then o_ins_lab("ld hl,(", s, ")") else o_ins_lab("ld hl,", s, "") end
        return
    end
    if k == E_INDEX then
        byte hw = is_hw(e)
        if hw == 1 then
            gen(n2[e], 2, false)
            pl_ty = TY_BYTE
            pl_len = 0
            return
        end
        if hw >= 2 then
            if fail_node(e) then msg("registers and ports have no address") end
            return
        end
        word base = n1[e]
        if nk[base] == E_NAME and not is_self(n1[base]) then
            word s = lookup(n1[base])
            if s ~= 0 and spage[s] ~= 0 then
                gen(n2[e], 2, false)
                scale(sty[s])
                os("    ld a,")
                odec(spage[s])
                onl()
                oi("call rt_far_map")
                pl_ty = sty[s]
                pl_len = 0
                return
            end
        end
        if not place_type(base) or pt_len == 0 then
            if fail_node(e) then msg("not an array") end
            return
        end
        byte et = pt_ty
        gen(n2[e], 2, false)
        scale(et)
        oi("push hl")
        gen_place(base)
        oi("pop de")
        oi("add hl,de")
        pl_ty = et
        pl_len = 0
        return
    end
    if k == E_FIELD then
        gen_place(n1[e])
        if failed then return end
        if not is_struct(pl_ty) or pl_len ~= 0 then
            if fail_node(e) then msg("not a struct") end
            return
        end
        word f = field_find(pl_ty - TY_STRUCT, n2[e])
        if f == 0 then
            if fail_node(e) then
                msg("no field `")
                msg_text(n2[e])
                msg("`")
            end
            return
        end
        if tabw[W_FD_OFF + f] ~= 0 then
            os("    ld de,")
            odec(tabw[W_FD_OFF + f])
            onl()
            oi("add hl,de")
        end
        pl_ty = tabb[B_FD_TY + f]
        pl_len = tabw[W_FD_LEN + f]
        return
    end
    if k == E_CALL or k == E_METHOD then
        byte t = nat(e)
        if is_struct(t) then
            gen_struct_value(e, t)
            pl_ty = t
            pl_len = 0
            return
        end
    end
    if fail_node(e) then msg("not a variable") end
end


-- load the value at HL (element type t) into HL / DE:HL
function load_at_hl(byte t)
    if tsize(t) == 1 then
        oi("ld a,(hl)")
        extend_a(t)
    elseif tsize(t) == 2 then
        oi("ld a,(hl)")
        oi("inc hl")
        oi("ld h,(hl)")
        oi("ld l,a")
    else
        oi("ld e,(hl)")
        oi("inc hl")
        oi("ld d,(hl)")
        oi("inc hl")
        oi("ld a,(hl)")
        oi("inc hl")
        oi("ld h,(hl)")
        oi("ld l,a")
        oi("ex de,hl")
    end
end

-- operands: left -> DE, right -> HL, both at (w, sg) (16-bit)
function gen_pair(word l, word r, byte w, bool sg)
    gen(l, w, sg)
    oi("push hl")
    gen(r, w, sg)
    oi("pop de")
end

-- 32-bit operands: left -> X (DE:HL), right -> Y (DE':HL')
function gen_pair32(word l, word r)
    gen(l, 4, true)
    oi("push de")
    oi("push hl")
    gen(r, 4, true)
    oi("exx")
    oi("pop hl")
    oi("pop de")
end

-- the result of a comparison from the flags (Z = equal, C = less): HL = 0 / 1
function bool_from_flags(byte op)
    word skip = new_label()
    oi("ld hl,0")
    if op == B_EQ then
        jp("jr nz,", skip)
    elseif op == B_NE then
        jp("jr z,", skip)
    elseif op == B_LT then
        jp("jr nc,", skip)
    elseif op == B_GE then
        jp("jr c,", skip)
    elseif op == B_GT then
        jp("jr c,", skip)
        jp("jr z,", skip)
    else
        -- le: less or equal
        word yes = new_label()
        jp("jr c,", yes)
        jp("jr nz,", skip)
        label(yes)
    end
    oi("inc hl")
    label(skip)
end

-- comparison l op r -> HL = 0 / 1
function gen_compare(byte op, word l, word r)
    byte t = join(nat(l), nat(r))
    if t == TY_STR then
        gen_str(l)
        oi("push hl")
        gen_str(r)
        oi("ex de,hl")
        oi("pop hl")
        oi("call rt_scmp")
        bool_from_flags(op)
        return
    end
    if t == TY_NONE then
        if const_eval(l) then t = lit_ty(cv) else t = TY_WORD end
        if const_eval(r) then t = join(t, lit_ty(cv)) end
    end
    if t == TY_BOOL then t = TY_BYTE end
    if t == TY_LONG then
        gen_pair32(l, r)
        oi("call rt_cmp32")
        bool_from_flags(op)
        return
    end
    bool sg = tsigned(t)
    gen_pair(l, r, tsize(t), sg)
    if sg then
        -- signed order = unsigned order with the sign bits flipped
        oi("ld a,d")
        oi("xor $80")
        oi("ld d,a")
        oi("ld a,h")
        oi("xor $80")
        oi("ld h,a")
    end
    oi("ex de,hl")
    oi("or a")
    oi("sbc hl,de")         -- left - right
    bool_from_flags(op)
end

-- arithmetic / bitwise l op r at (w, sg) -> HL / DE:HL
function gen_arith(byte op, word l, word r, byte w, bool sg)
    if op == B_CONCAT then
        unsupported(l, "a string here")
        return
    end
    if w == 4 then
        gen_arith32(op, l, r)
        return
    end
    gen_pair(l, r, w, sg)
    if op == B_ADD then
        oi("add hl,de")
    elseif op == B_SUB then
        oi("ex de,hl")
        oi("or a")
        oi("sbc hl,de")
    elseif op == B_MUL then
        oi("call rt_mul16")
    elseif op == B_DIV or op == B_MOD then
        oi("ex de,hl")
        if sg then oi("call rt_divs16") else oi("call rt_divu16") end
        if op == B_MOD then oi("ex de,hl") end
    elseif op == B_AND or op == B_OR or op == B_XOR then
        string ins = "and "
        if op == B_OR then ins = "or " end
        if op == B_XOR then ins = "xor " end
        oi("ld a,h")
        oi(ins .. "d")
        oi("ld h,a")
        oi("ld a,l")
        oi(ins .. "e")
        oi("ld l,a")
    elseif op == B_SHL or op == B_SHR then
        word lp = new_label()
        word done = new_label()
        oi("ld a,l")
        oi("and 31")
        oi("ld b,a")
        oi("ex de,hl")
        jp("jr z,", done)
        label(lp)
        if op == B_SHL then
            oi("add hl,hl")
        else
            if sg then oi("sra h") else oi("srl h") end
            oi("rr l")
        end
        jp("djnz ", lp)
        label(done)
    end
    fix(w, sg)
end

function gen_arith32(byte op, word l, word r)
    uses_long = true
    if op == B_SHL or op == B_SHR then
        gen(l, 4, true)
        oi("push de")
        oi("push hl")
        gen(r, 2, false)
        oi("ld a,l")
        oi("and 31")
        oi("ld b,a")
        oi("pop hl")
        oi("pop de")
        if op == B_SHL then oi("call rt_shl32") else oi("call rt_sar32") end
        return
    end
    gen_pair32(l, r)
    if op == B_ADD then
        oi("call rt_add32")
    elseif op == B_SUB then
        oi("call rt_sub32")
    elseif op == B_MUL then
        oi("call rt_mul32")
    elseif op == B_DIV then
        oi("call rt_divs32")
    elseif op == B_MOD then
        oi("call rt_mods32")
    elseif op == B_AND then
        oi("call rt_and32")
    elseif op == B_OR then
        oi("call rt_or32")
    else
        oi("call rt_xor32")
    end
end

-- e -> HL at width w (1 / 2) and signedness sg; DE:HL when w = 4
function gen(word e, byte w, bool sg)
    if failed then return end
    if w == 4 then
        gen32(e)
        return
    end
    byte k = nk[e]
    if k == E_INT or k == E_BOOL then
        const_eval(e)
        load_const(cv, w, sg)
    elseif k == E_NAME then
        word s = var_sym(e, n1[e])
        if s == 0 then return end
        if sk[s] == SK_CONST then
            load_const(const_value(s), w, sg)
        elseif slen[s] ~= 0 or sty[s] == TY_STR or is_struct(sty[s]) then
            if fail_node(e) then msg("not a number") end
        else
            load_sym(s)
        end
    elseif k == E_INDEX then
        byte hw = is_hw(e)
        if hw >= 2 then
            gen_hw_read(e, hw)
            return
        end
        gen_place(e)
        if failed then return end
        if pl_ty == TY_STR or is_struct(pl_ty) or pl_len ~= 0 then
            if fail_node(e) then msg("not a number") end
            return
        end
        load_at_hl(pl_ty)
    elseif k == E_FIELD then
        gen_place(e)
        if failed then return end
        if pl_ty == TY_STR or is_struct(pl_ty) or pl_len ~= 0 then
            if fail_node(e) then msg("not a number") end
            return
        end
        load_at_hl(pl_ty)
    elseif k == E_METHOD then
        gen_method_call(e)
        word f = resolve_method(e)
        if f ~= 0 and sty[f] ~= TY_NONE and not is_struct(sty[f]) and sty[f] ~= TY_STR then
            if tsize(sty[f]) == 1 then extend_a(sty[f]) end
        end
    elseif k == E_UNARY then
        byte op = nf[e]
        if op == 1 then
            gen(n1[e], 1, false)
            oi("ld a,l")
            oi("xor 1")
            oi("ld l,a")
        elseif op == 0 then
            gen(n1[e], w, sg)
            oi("ex de,hl")
            oi("ld hl,0")
            oi("or a")
            oi("sbc hl,de")
            fix(w, sg)
        else
            gen(n1[e], w, sg)
            oi("ld a,h")
            oi("cpl")
            oi("ld h,a")
            oi("ld a,l")
            oi("cpl")
            oi("ld l,a")
            fix(w, sg)
        end
    elseif k == E_BINARY then
        byte op = nf[e]
        if op == B_LAND or op == B_LOR then
            word done = new_label()
            gen(n1[e], 1, false)
            oi("ld a,l")
            oi("or a")
            if op == B_LAND then jp("jp z,", done) else jp("jp nz,", done) end
            gen(n2[e], 1, false)
            label(done)
        elseif op >= B_EQ then
            gen_compare(op, n1[e], n2[e])
        else
            gen_arith(op, n1[e], n2[e], w, sg)
        end
    elseif k == E_CALL then
        if (text_is(n1[e], "abs") or text_is(n1[e], "min") or text_is(n1[e], "max")) and const_eval(e) then
            load_const(cv, w, sg)
            return
        end
        gen_call(e, w, sg)
    elseif k == E_STR then
        if fail_node(e) then msg("not a number") end
    else
        unsupported(e, "this expression")
    end
end

-- e -> DE:HL (32-bit)
function gen32(word e)
    if failed then return end
    uses_long = true
    byte k = nk[e]
    byte t = nat(e)
    if k == E_INT or k == E_BOOL then
        const_eval(e)
        load_const(cv, 4, true)
        return
    end
    if k == E_NAME then
        word s = var_sym(e, n1[e])
        if s == 0 then return end
        if sk[s] == SK_CONST then
            load_const(const_value(s), 4, true)
            return
        end
    end
    if t == TY_LONG then
        if k == E_NAME then
            load_sym(lookup(n1[e]))
        elseif k == E_INDEX or k == E_FIELD then
            gen_place(e)
            load_at_hl(TY_LONG)
        elseif k == E_METHOD then
            gen_method_call(e)
        elseif k == E_UNARY then
            gen32(n1[e])
            if nf[e] == 0 then oi("call rt_neg32") else oi("call rt_cpl32") end
        elseif k == E_BINARY then
            gen_arith32(nf[e], n1[e], n2[e])
        elseif k == E_CALL then
            gen_call(e, 4, true)
        else
            unsupported(e, "this expression")
        end
        return
    end
    -- a narrower value: computed at 32 bits when it is arithmetic
    if k == E_BINARY and nf[e] < B_EQ then
        gen_arith32(nf[e], n1[e], n2[e])
        return
    end
    if k == E_UNARY and nf[e] ~= 1 then
        gen32(n1[e])
        if nf[e] == 0 then oi("call rt_neg32") else oi("call rt_cpl32") end
        return
    end
    if t == TY_NONE or t == TY_BOOL then t = TY_WORD end
    gen(e, tsize(t), tsigned(t))
    extend32(tsigned(t))
end

-- e evaluated for a destination of type d (HL / DE:HL; strings: address)
function gen_for(word e, byte d)
    if d == TY_STR then
        gen_str(e)
        return
    end
    byte t = ctx_ty(d, e)
    gen(e, tsize(t), tsigned(t))
end

function count(word first) -> byte
    byte n = 0
    while first ~= 0 do
        n += 1
        first = nx[first]
    end
    return n
end

function want_args(word e, byte n) -> bool
    if count(n2[e]) == n then return true end
    if fail_node(e) then
        msg("`")
        msg_text(n1[e])
        msg("` expects ")
        msg_dec(0, n)
        msg(" argument(s)")
    end
    return false
end

-- ---- strings

-- the address of string e in HL
function gen_str(word e)
    if failed then return end
    byte k = nk[e]
    if k == E_STR then
        word l = pstr_label(n1[e])
        os("    ld hl,ps_")
        odec(l)
        onl()
        return
    end
    if k == E_NAME or k == E_INDEX or k == E_FIELD then
        gen_place(e)
        if failed then return end
        if pl_ty ~= TY_STR or pl_len ~= 0 then
            if fail_node(e) then msg("not a string") end
        end
        return
    end
    if k == E_METHOD then
        gen_method_call(e)
        return
    end
    word t = 0
    if k == E_BINARY and nf[e] == B_CONCAT then
        t = temp_str()
        oi("xor a")
        o_ins_lab("ld (", t, "),a")
        str_build(t, e)
        o_ins_lab("ld hl,", t, "")
        return
    end
    if k == E_CALL then
        word name = n1[e]
        if text_is(name, "chr") then
            if not want_args(e, 1) then return end
            t = temp_str()
            gen(n2[e], 1, false)
            oi("ld a,l")
            o_ins_lab("ld (", t, "+1),a")
            oi("ld a,1")
            o_ins_lab("ld (", t, "),a")
            o_ins_lab("ld hl,", t, "")
            return
        end
        if text_is(name, "str") then
            if not want_args(e, 1) then return end
            t = temp_str()
            oi("xor a")
            o_ins_lab("ld (", t, "),a")
            str_add(t, n2[e])
            o_ins_lab("ld hl,", t, "")
            return
        end
        word f = lookup(name)
        if f ~= 0 and sk[f] == SK_FUNC and sty[f] == TY_STR then
            call_func(e, f, n2[e])
            return
        end
        unsupported(e, "this string function")
        return
    end
    if fail_node(e) then msg("not a string") end
end

-- append the parts of a `..` chain to temporary t
function str_build(word t, word e)
    if nk[e] == E_BINARY and nf[e] == B_CONCAT then
        str_build(t, n1[e])
        str_add(t, n2[e])
        return
    end
    str_add(t, e)
end

-- append e (a string, number or bool, as text) to temporary t
function str_add(word t, word e)
    byte ty = nat(e)
    if ty == TY_STR then
        gen_str(e)
        o_ins_lab("ld de,", t, "")
        oi("call rt_scat")
        return
    end
    if ty == TY_BOOL then
        gen(e, 1, false)
        oi("ld a,l")
        o_ins_lab("ld de,", t, "")
        oi("call rt_fmt_on")
        oi("call rt_print_bool")
        oi("call rt_fmt_off")
        return
    end
    if ty == TY_NONE then
        if const_eval(e) then ty = lit_ty(cv) else ty = TY_WORD end
    end
    gen(e, tsize(ty), tsigned(ty))
    if ty == TY_LONG then
        oi("push de")
        oi("push hl")
        o_ins_lab("ld de,", t, "")
        oi("call rt_fmt_on")
        oi("pop hl")
        oi("pop de")
        oi("call rt_print_s32")
    else
        o_ins_lab("ld de,", t, "")
        oi("call rt_fmt_on")
        if tsigned(ty) then oi("call rt_print_s16") else oi("call rt_print_u16") end
    end
    oi("call rt_fmt_off")
end

-- a call in an expression -> HL (DE:HL)
function gen_call(word e, byte w, bool sg)
    word name = n1[e]
    word alist = n2[e]
    byte c = is_cast(name)
    if c ~= TY_BAD then
        if count(alist) ~= 1 then
            if fail_node(e) then msg("a cast takes one value") end
            return
        end
        byte t = nat(alist)
        if t == TY_NONE or t == TY_BOOL then t = ctx_ty(c, alist) end
        gen(alist, tsize(t), tsigned(t))
        if tsize(c) == 4 then
            if tsize(t) < 4 then extend32(tsigned(t)) end
            return
        end
        if tsize(c) == 1 then fix(1, tsigned(c)) end
        if w == 4 then extend32(tsigned(c)) end
        return
    end
    if text_is(name, "len") then
        if not want_args(e, 1) then return end
        gen_str(alist)
        oi("ld a,(hl)")
        extend_a(TY_BYTE)
        if w == 4 then extend32(false) end
        return
    end
    if text_is(name, "asc") then
        if not want_args(e, 2) then return end
        gen(nx[alist], 1, false)
        oi("push hl")
        gen_str(alist)
        oi("pop de")
        oi("ld a,e")
        oi("call rt_sasc")
        extend_a(TY_BYTE)
        if w == 4 then extend32(false) end
        return
    end
    if text_is(name, "addr") then
        if not want_args(e, 1) then return end
        gen_address_of(alist)
        if w == 4 then extend32(false) end
        return
    end
    if text_is(name, "chr") or text_is(name, "str") then
        if fail_node(e) then msg("a string is not a number") end
        return
    end
    word f = lookup(name)
    if (f == 0 or sk[f] ~= SK_FUNC) and builtin_expr(e, w) then return end
    if f == 0 or sk[f] ~= SK_FUNC then
        if fail_node(e) then
            msg("not supported by the self-hosted compiler yet: function `")
            msg_text(name)
            msg("`")
        end
        return
    end
    call_func(e, f, alist)
    byte r = sty[f]
    if r == TY_NONE then return end
    if tsize(r) == 1 then extend_a(r) end
    if w == 4 and tsize(r) < 4 then extend32(tsigned(r)) end
end

-- built-in functions with a value: true if e is one (its value in HL / DE:HL)
function builtin_expr(word e, byte w) -> bool
    word name = n1[e]
    word a = n2[e]
    byte rt = TY_NONE
    if text_is(name, "image_width") or text_is(name, "image_height") then
        if not want_args(e, 1) then return true end
        if not const_eval(e) then
            if fail_node(a) then msg("expected an image asset: `asset name = image(\"file.png\")`") end
            return true
        end
        load_const(cv, 2, false)
        if w == 4 then extend32(false) end
        return true
    end
    if text_is(name, "note_period") then
        if not want_args(e, 1) then return true end
        uses_notes = true
        gen(a, 1, false)
        oi("ld a,l")
        oi("call rt_note_period")
        if w == 4 then extend32(false) end
        return true
    end
    if text_is(name, "sample_playing") then
        if not want_args(e, 0) then return true end
        uses_samples = true
        oi("ld a,(rt_smp_on)")
        extend_a(TY_BYTE)
        if w == 4 then extend32(false) end
        return true
    end
    if text_isx(name, "p|oint") then
        if not want_args(e, 2) then return true end
        gen(nx[a], 1, false)
        oi("push hl")
        gen(a, 2, false)
        oi("pop de")
        oi("ld d,e")
        oi("call rt_p" .. "oint")
        extend_a(TY_BYTE)
        rt = TY_BYTE
    elseif text_isx(name, "l|ayer2_width") then
        if not want_args(e, 0) then return true end
        oi("ld hl,(rt_l2wid)")
        rt = TY_WORD
    elseif text_isx(name, "l|ayer2_height") then
        if not want_args(e, 0) then return true end
        oi("ld a,(rt_l2hmax)")
        oi("ld l,a")
        oi("ld h,0")
        oi("inc hl")
        rt = TY_WORD
    elseif text_is(name, "frames") then
        if not want_args(e, 0) then return true end
        oi("ld hl,(rt_frames)")
        rt = TY_WORD
    elseif text_is(name, "random") then
        if not want_args(e, 1) then return true end
        gen(a, 2, false)
        oi("call rt_random")
        rt = TY_WORD
    elseif text_is(name, "kempston") then
        if not want_args(e, 0) then return true end
        oi("in a,($1f)")
        extend_a(TY_BYTE)
        rt = TY_BYTE
    elseif text_is(name, "any_key") then
        if not want_args(e, 0) then return true end
        oi("call rt_any_key")
        extend_a(TY_BYTE)
        rt = TY_BYTE
    elseif text_is(name, "key") then
        if not want_args(e, 1) then return true end
        gen(a, 1, false)
        oi("ld a,l")
        oi("call rt_key")
        extend_a(TY_BYTE)
        rt = TY_BYTE
    elseif text_is(name, "abs") then
        if not want_args(e, 1) then return true end
        byte t = nat(a)
        if t == TY_NONE then t = ctx_ty(TY_NONE, a) end
        gen(a, tsize(t), tsigned(t))
        if tsigned(t) then
            word pos_ = new_label()
            if tsize(t) == 4 then
                oi("bit 7,d")
                jp("jr z,", pos_)
                oi("call rt_neg32")
            else
                oi("bit 7,h")
                jp("jr z,", pos_)
                oi("ex de,hl")
                oi("ld hl,0")
                oi("or a")
                oi("sbc hl,de")
                fix(tsize(t), true)
            end
            label(pos_)
        end
        rt = t
    elseif text_is(name, "min") or text_is(name, "max") then
        if not want_args(e, 2) then return true end
        bool is_min = text_is(name, "min")
        byte t = join(nat(a), nat(nx[a]))
        if t == TY_NONE then
            t = ctx_ty(TY_NONE, a)
            t = join(t, ctx_ty(TY_NONE, nx[a]))
        end
        if t == TY_LONG then
            gen_pair32(a, nx[a])
            if is_min then oi("call rt_min32") else oi("call rt_max32") end
            return true
        end
        bool sg = tsigned(t)
        gen_pair(a, nx[a], tsize(t), sg)     -- DE = a, HL = b
        oi("push hl")
        oi("push de")
        if sg then
            oi("ld a,h")
            oi("xor $80")
            oi("ld h,a")
            oi("ld a,d")
            oi("xor $80")
            oi("ld d,a")
        end
        oi("or a")
        oi("sbc hl,de")         -- C: b < a
        oi("pop de")
        oi("pop hl")
        word keep = new_label()
        if is_min then jp("jr c,", keep) else jp("jr nc,", keep) end
        oi("ex de,hl")
        label(keep)
        rt = t
    else
        return false
    end
    if w == 4 and tsize(rt) < 4 then extend32(tsigned(rt)) end
    return true
end

-- built-in procedures: true if e is one
function builtin_stmt(word e) -> bool
    word name = n1[e]
    word a = n2[e]
    if text_isx(name, "s|prite_load") then
        if not want_args(e, 2) then return true end
        byte sa = asset_arg(nx[a], AK_PAT)
        if sa == 255 then
            if fail_node(nx[a]) then msg("second argument must be a pattern asset (.png / .spr)") end
            return true
        end
        if const_eval(a) then
            if cv < 0 or cv + tabw[W_AS_N + sa] > 64 then
                if fail_node(a) then msg("these patterns do not fit the 64 pattern slots") end
                return true
            end
        end
        gen(a, 1, false)
        oi("ld a,l")
        os("    ld hl,")
        o_asset(sa)
        os("\n    ld d,")
        odec(tabw[W_AS_N + sa])
        os("\n    call rt_s")
        os("prite_upload\n")
        return true
    end
    if text_is(name, "draw_image") then
        if not want_args(e, 3) then return true end
        byte ia = asset_arg(a, AK_IMG)
        if ia == 255 then
            if fail_node(a) then msg("expected an image asset: `asset name = image(\"file.png\")`") end
            return true
        end
        gen(nx[a], 2, true)
        oi("ld (rt_img_x),hl")
        gen(nx[nx[a]], 2, true)
        oi("ld (rt_img_y),hl")
        os("    ld hl,")
        o_asset(ia)
        os("\n    call rt_draw_image\n")
        return true
    end
    if text_is(name, "sample_play") or text_is(name, "sample_loop") then
        if not want_args(e, 1) then return true end
        byte wa = asset_arg(a, AK_WAV)
        if wa == 255 then
            if fail_node(a) then msg("expected the name of a sample asset (`asset name = \"file.wav\"`)") end
            return true
        end
        uses_samples = true
        os("    ld hl,")
        o_asset(wa)
        onl()
        if text_is(name, "sample_loop") then oi("ld a,1") else oi("xor a") end
        oi("call rt_smp_play")
        return true
    end
    if text_is(name, "dma_copy") or text_is(name, "dma_fill") then
        -- copy: HL = source, DE = destination, BC = length;
        -- fill: DE = destination, BC = length, A = value
        if not want_args(e, 3) then return true end
        bool fill = text_is(name, "dma_fill")
        if fill then gen(nx[nx[a]], 1, false) else gen(nx[nx[a]], 2, false) end
        oi("push hl")
        gen(nx[a], 2, false)
        oi("push hl")
        gen(a, 2, false)
        if fill then
            oi("ex de,hl")
            oi("pop bc")
            oi("pop hl")
            oi("ld a,l")
            oi("call rt_dma_fill")
        else
            oi("pop de")
            oi("pop bc")
            oi("call rt_dma_copy")
        end
        return true
    end
    if text_is(name, "cpu_speed") then
        if not want_args(e, 1) then return true end
        gen(a, 1, false)
        oi("ld a,l")
        oi("and 3")
        oi("nextreg $07,a")
        return true
    end
    if text_is(name, "ay_write") then
        if not want_args(e, 3) then return true end
        gen(nx[nx[a]], 1, false)
        oi("push hl")
        gen(nx[a], 1, false)
        oi("push hl")
        gen(a, 1, false)
        oi("ld d,l")
        oi("pop hl")
        oi("ld a,l")
        oi("pop hl")
        oi("ld e,l")
        oi("call rt_ay_write")
        return true
    end
    if text_is(name, "sample_stop") then
        if not want_args(e, 0) then return true end
        uses_samples = true
        oi("call rt_smp_stop")
        return true
    end
    if text_isx(name, "p|lot") or text_isx(name, "h|line") then
        -- D = y, HL = x, A = colour, BC = length (horizontal line)
        bool h = text_isx(name, "h|line")
        if h then
            if not want_args(e, 4) then return true end
            gen(nx[nx[nx[a]]], 1, false)
            oi("push hl")
            gen(nx[nx[a]], 2, false)
            oi("push hl")
        else
            if not want_args(e, 3) then return true end
            gen(nx[nx[a]], 1, false)
            oi("push hl")
        end
        gen(nx[a], 1, false)
        oi("push hl")
        gen(a, 2, false)
        oi("pop de")
        oi("ld d,e")
        if h then
            oi("pop bc")
            oi("ex (sp),hl")
            oi("ld a,l")
            oi("pop hl")
            oi("call rt_h" .. "line")
        else
            oi("ex (sp),hl")
            oi("ld a,l")
            oi("pop hl")
            oi("call rt_p" .. "lot")
        end
        return true
    end
    -- no arguments
    string r0 = ""
    if text_is(name, "vsync") then r0 = "rt_vsync" end
    if text_is(name, "cls") then r0 = "rt_cls" end
    if text_is(name, "wait_key") then r0 = "rt_wait_key" end
    if text_isx(name, "l|ayer2_flip") then r0 = "rt_l2_flip" end
    if r0 ~= "" then
        if not want_args(e, 0) then return true end
        oi("call " .. r0)
        return true
    end
    -- one word argument in HL
    string rw = ""
    if text_is(name, "pause") then rw = "rt_pause" end
    if text_is(name, "seed") then rw = "rt_seed" end
    if rw ~= "" then
        if not want_args(e, 1) then return true end
        gen(a, 2, false)
        oi("call " .. rw)
        return true
    end
    -- one byte argument in A
    string rb = ""
    if text_is(name, "border") then rb = "rt_border" end
    if text_is(name, "ink") then rb = "rt_set_ink" end
    if text_isx(name, "l|ayer2_clear") then rb = "rt_l2_clear" end
    if text_isx(name, "l|ayer2_mode") then rb = "rt_l2_setmode" end
    if rb ~= "" then
        if not want_args(e, 1) then return true end
        gen(a, 1, false)
        oi("ld a,l")
        oi("call " .. rb)
        return true
    end
    if text_is(name, "at") then
        if not want_args(e, 2) then return true end
        gen(a, 1, false)
        oi("ld a,l")
        oi("call rt_set_row")
        gen(nx[a], 1, false)
        oi("ld a,l")
        oi("call rt_set_col")
        return true
    end
    return false
end

-- addr(x): a variable, an array or an element
function gen_address_of(word a)
    if nk[a] == E_NAME and not is_self(n1[a]) then
        word s = lookup(n1[a])
        if s ~= 0 and (sk[s] == SK_CONST or spage[s] ~= 0) then
            unsupported(a, "addr() of this")
            return
        end
    end
    gen_place(a)
end

-- ---- structs: values, constructors, methods

-- is struct a the struct b or derived from it?
function is_sub(byte a, byte b) -> bool
    while a ~= 255 do
        if a == b then return true end
        a = tabb[B_ST_PARENT + a]
    end
    return false
end

function not_a(word e, byte a, byte b)
    if fail_node(e) then
        msg("a `")
        msg_text(tabw[W_ST_NAME + a])
        msg("` is not a `")
        msg_text(tabw[W_ST_NAME + b])
        msg("`")
    end
end

-- `Type(args)`: a constructor call
function is_ctor(word e) -> bool
    if nk[e] ~= E_CALL or struct_by_name(n1[e]) == 255 then return false end
    word f = lookup(n1[e])
    return f == 0 or sk[f] ~= SK_FUNC
end

-- a value that is made rather than read: a `{...}` list, a constructor or
-- a call returning a struct
function is_maker(word e) -> bool
    byte k = nk[e]
    if k == E_LIST then return true end
    return (k == E_CALL or k == E_METHOD) and is_struct(nat(e))
end

function add_off(word off)
    if off == 0 then return end
    os("    ld de,")
    odec(off)
    onl()
    oi("add hl,de")
end

function o_sd(byte k)
    os("sd_")
    otok(tabw[W_ST_NAME + k])
end

-- the return buffer of function f (strings, structs)
function o_ret(string ins, word f)
    os("    ")
    os(ins)
    os("r_")
    o_fnname(f)
    onl()
end

-- copy `size` bytes from HL to DE (nothing for 0)
function o_ldir(word size)
    if size == 0 then return end
    os("    ld bc,")
    odec(size)
    onl()
    oi("ldir")
end

-- DE = destination: copy the default image of struct k there
function copy_image(byte k)
    os("    ld hl,")
    o_sd(k)
    onl()
    o_ldir(tabw[W_ST_SIZE + k])
end

-- a hidden word local holding HL (a destination address)
function hold_hl() -> word
    word d = new_local(0, TY_WORD)
    sdead[d] = 1
    o_ins_lab("ld (", d, "),hl")
    return d
end

-- the value `item` into the element of type t at (d) + off
function elem_store(byte t, word d, word off, word item)
    if failed then return end
    if is_struct(t) then
        o_ins_lab("ld hl,(", d, ")")
        add_off(off)
        struct_into_hl(t, item)
        return
    end
    if t == TY_STR then
        gen_str(item)
        oi("push hl")
        o_ins_lab("ld hl,(", d, ")")
        add_off(off)
        oi("ex de,hl")
        oi("pop hl")
        oi("call rt_scopy")
        return
    end
    if nk[item] == E_LIST then
        if fail_node(item) then msg("a list for a field that is not a struct or an array") end
        return
    end
    gen_for(item, t)
    push_val(t)
    o_ins_lab("ld hl,(", d, ")")
    add_off(off)
    store_at_hl(t)
end

-- values to the fields of struct k (at the address in d), in order
function fill_fields(word e, byte k, word d, word items)
    word n = 0
    word it = items
    while it ~= 0 and not failed do
        if n >= tabw[W_ST_NF + k] then
            if fail_node(e) then
                msg("`")
                msg_text(tabw[W_ST_NAME + k])
                msg("` has ")
                msg_dec(0, tabw[W_ST_NF + k])
                msg(" fields (or give it an `init` method)")
            end
            return
        end
        word x = tabw[W_ST_FF + k] + n
        if tabw[W_FD_LEN + x] ~= 0 then
            if nk[it] ~= E_LIST then
                if fail_node(it) then
                    msg("field `")
                    msg_text(tabw[W_FD_NAME + x])
                    msg("` is an array: give it a `{...}` list")
                end
                return
            end
            word el = n1[it]
            word j = 0
            word esz = tstore(tabb[B_FD_TY + x])
            while el ~= 0 and not failed do
                if j >= tabw[W_FD_LEN + x] then
                    if fail_node(el) then msg("too many values for this array field") end
                    return
                end
                elem_store(tabb[B_FD_TY + x], d, tabw[W_FD_OFF + x] + j * esz, el)
                el = nx[el]
                j += 1
            end
        else
            elem_store(tabb[B_FD_TY + x], d, tabw[W_FD_OFF + x], it)
        end
        it = nx[it]
        n += 1
    end
end

-- self for the next call_args: 0 none, 1 the object node ps_val,
-- 2 the current self, 3 the word in symbol ps_val
byte ps_kind = 0
word ps_val = 0

-- `Type(args)` built at the address in HL: the defaults, then `init(args)`
-- if the class has one, else the arguments to the fields in order
function construct(word e, byte k)
    word d = hold_hl()
    oi("ex de,hl")
    copy_image(k)
    word f = tabw[W_ST_INIT + k]
    if f ~= 0 then
        ps_kind = 3
        ps_val = d
        call_func(e, f, n2[e])
        return
    end
    fill_fields(e, k, d, n2[e])
end

-- the struct value v (of type t, or derived) into the struct at the
-- address in HL; v may not use that struct (see assign)
function struct_into_hl(byte t, word v)
    if failed then return end
    byte k = t - TY_STRUCT
    if nk[v] == E_LIST then
        word d = hold_hl()
        oi("ex de,hl")
        copy_image(k)
        fill_fields(v, k, d, n1[v])
        return
    end
    if is_ctor(v) then
        byte ck = struct_by_name(n1[v])
        if not is_sub(ck, k) then
            not_a(v, ck, k)
            return
        end
        if ck == k then
            construct(v, k)
            return
        end
        -- a derived class into a base: built aside, its base part copied
        oi("push hl")
        word tmp = new_local(0, TY_STRUCT + ck)
        sdead[tmp] = 1
        o_ins_lab("ld hl,", tmp, "")
        construct(v, ck)
        o_ins_lab("ld hl,", tmp, "")
        oi("pop de")
        o_ldir(tabw[W_ST_SIZE + k])
        return
    end
    if not place_type(v) or not is_struct(pt_ty) or pt_len ~= 0 then
        if fail_node(v) then
            msg("expected a `")
            msg_text(tabw[W_ST_NAME + k])
            msg("` value")
        end
        return
    end
    if not is_sub(pt_ty - TY_STRUCT, k) then
        not_a(v, pt_ty - TY_STRUCT, k)
        return
    end
    oi("push hl")
    gen_place(v)
    oi("pop de")
    o_ldir(tabw[W_ST_SIZE + k])
end

-- the address of a struct argument for a parameter of type t (a made value:
-- built in a hidden local first)
function gen_struct_arg(word a, byte t)
    if is_maker(a) then
        word tmp = new_local(0, t)
        sdead[tmp] = 1
        o_ins_lab("ld hl,", tmp, "")
        struct_into_hl(t, a)
        o_ins_lab("ld hl,", tmp, "")
        return
    end
    if not place_type(a) or not is_struct(pt_ty) or pt_len ~= 0 then
        if fail_node(a) then
            msg("expected a `")
            msg_text(tabw[W_ST_NAME + (t - TY_STRUCT)])
            msg("` value")
        end
        return
    end
    if not is_sub(pt_ty - TY_STRUCT, t - TY_STRUCT) then
        not_a(a, pt_ty - TY_STRUCT, t - TY_STRUCT)
        return
    end
    gen_place(a)
end

-- a call or constructor making a struct: its address in HL
function gen_struct_value(word e, byte t)
    if is_ctor(e) then
        word tmp = new_local(0, t)
        sdead[tmp] = 1
        o_ins_lab("ld hl,", tmp, "")
        struct_into_hl(t, e)
        o_ins_lab("ld hl,", tmp, "")
        return
    end
    if nk[e] == E_METHOD then
        gen_method_call(e)
        return
    end
    call_func(e, lookup(n1[e]), n2[e])  -- HL = its return buffer
end

-- the method an E_METHOD calls (0: none); how self is given in rm_kind:
-- 1 the object, 2 the current self (`super`), 0 the first argument (`Type.m(obj)`)
byte rm_kind = 0
function resolve_method(word e) -> word
    word obj = n1[e]
    word name = n2[e]
    if nk[obj] == E_NAME and not is_self(n1[obj]) and lookup(n1[obj]) == 0 then
        if text_is(n1[obj], "super") then
            if cur_fn == 0 or sstruct[cur_fn] == 0 then return 0 end
            byte p = tabb[B_ST_PARENT + (sstruct[cur_fn] - 1)]
            if p == 255 then return 0 end
            rm_kind = 2
            return method_find(p, name)
        end
        byte k = struct_by_name(n1[obj])
        if k == 255 then return 0 end
        rm_kind = 0
        return method_find(k, name)
    end
    if not place_type(obj) or not is_struct(pt_ty) or pt_len ~= 0 then return 0 end
    byte k = pt_ty - TY_STRUCT
    rm_kind = 1
    return method_find(k, name)
end

-- a method call (the value in A / HL / DE:HL as for a function)
function gen_method_call(word e)
    if failed then return end
    word f = resolve_method(e)
    if f == 0 then
        if fail_node(e) then
            msg("no method `")
            msg_text(n2[e])
            msg("` for this")
        end
        return
    end
    ps_kind = rm_kind
    ps_val = n1[e]
    call_func(e, f, n3[e])
end

-- an array or a single struct variable: defaults, then the initializer
function declare_struct_var(word v, word init)
    byte ty = sty[v]
    byte k = ty - TY_STRUCT
    word n = slen[v]
    word size = tabw[W_ST_SIZE + k]
    if has_defaults(k) then
        o_ins_lab("ld de,", v, "")
        if n <= 1 then
            copy_image(k)
        else
            os("    ld hl,")
            odec(n)
            onl()
            word lp = new_label()
            label(lp)
            oi("push hl")
            copy_image(k)
            oi("pop hl")
            oi("dec hl")
            oi("ld a,h")
            oi("or l")
            jp("jp nz,", lp)
        end
    end
    if init == 0 then return end
    if n == 0 then
        o_ins_lab("ld hl,", v, "")
        struct_into_hl(ty, init)
        return
    end
    if nk[init] ~= E_LIST then
        if fail_node(init) then msg("an array of structs takes a `{...}` list") end
        return
    end
    word item = n1[init]
    word i = 0
    while item ~= 0 and not failed do
        if i >= n then
            if fail_node(item) then msg("too many values for this array") end
            return
        end
        o_ins_lab("ld hl,", v, "")
        add_off(i * size)
        struct_into_hl(ty, item)
        item = nx[item]
        i += 1
    end
end

-- the default image of struct k (data)
function out_image(byte k)
    word f = tabw[W_ST_FF + k]
    word n = 0
    while n < tabw[W_ST_NF + k] do
        word x = f + n
        byte t = tabb[B_FD_TY + x]
        word cnt = tabw[W_FD_LEN + x]
        if cnt == 0 then cnt = 1 end
        if is_struct(t) then
            word j = 0
            while j < cnt do
                out_image(t - TY_STRUCT)
                j += 1
            end
        elseif tabb[B_FD_HASDEF + x] ~= 0 then
            os("    db ")
            word v = tabw[W_FD_DEFL + x]
            odec(v & 255)
            if tsize(t) >= 2 then
                ob(',')
                odec(v >> 8)
            end
            if tsize(t) == 4 then
                ob(',')
                odec(tabw[W_FD_DEFH + x] & 255)
                ob(',')
                odec(tabw[W_FD_DEFH + x] >> 8)
            end
            onl()
        else
            os("    ds ")
            odec(cnt * tstore(t))
            onl()
        end
        n += 1
    end
end

-- a struct declaration: its fields (the parent's first)
function declare_struct(word it)
    word name = n1[it]
    if nstructs >= MAXSTRUCT then
        if fail_node(it) then msg("too many structs") end
        return
    end
    if struct_by_name(name) ~= 255 or lookup(name) ~= 0 then
        if fail_node(it) then
            msg("`")
            msg_text(name)
            msg("` is already defined")
        end
        return
    end
    byte k = nstructs
    tabw[W_ST_NAME + k] = name
    tabb[B_ST_PARENT + k] = 255
    tabw[W_ST_FF + k] = nfields + 1
    tabw[W_ST_NF + k] = 0
    tabw[W_ST_INIT + k] = 0
    long off = 0
    if n2[it] ~= 0 then
        byte p = struct_by_name(n2[it])
        if p == 255 then
            if fail_node(it) then
                msg("unknown parent class `")
                msg_text(n2[it])
                msg("` (declare it first)")
            end
            return
        end
        tabb[B_ST_PARENT + k] = p
        word i = 0
        while i < tabw[W_ST_NF + p] do
            if nfields >= MAXFIELD - 1 then
                if fail_node(it) then msg("too many fields") end
                return
            end
            word a = tabw[W_ST_FF + p] + i
            nfields += 1
            tabw[W_FD_NAME + nfields] = tabw[W_FD_NAME + a]
            tabb[B_FD_TY + nfields] = tabb[B_FD_TY + a]
            tabw[W_FD_LEN + nfields] = tabw[W_FD_LEN + a]
            tabw[W_FD_OFF + nfields] = tabw[W_FD_OFF + a]
            tabb[B_FD_HASDEF + nfields] = tabb[B_FD_HASDEF + a]
            tabw[W_FD_DEFL + nfields] = tabw[W_FD_DEFL + a]
            tabw[W_FD_DEFH + nfields] = tabw[W_FD_DEFH + a]
            i += 1
        end
        tabw[W_ST_NF + k] = tabw[W_ST_NF + p]
        off = tabw[W_ST_SIZE + p]
    end
    word fdn = n3[it]
    while fdn ~= 0 do
        if field_find(k, n1[fdn]) ~= 0 then
            if fail_node(fdn) then
                msg("duplicate field `")
                msg_text(n1[fdn])
                msg("`")
            end
            return
        end
        byte t = type_of(n2[fdn])
        if t == TY_BAD then
            unsupported(fdn, "this field type")
            return
        end
        word cnt = 0
        word size = n3[fdn]
        if size ~= 0 then
            if nk[size] == E_LIST then
                unsupported(fdn, "array fields of more than one dimension")
                return
            end
            if not const_eval(size) or cv < 1 or cv > 65535 then
                if fail_node(size) then msg("an array size must be a constant 1..65535") end
                return
            end
            cnt = word(cv)
        end
        if nfields >= MAXFIELD - 1 then
            if fail_node(it) then msg("too many fields") end
            return
        end
        nfields += 1
        tabw[W_FD_NAME + nfields] = n1[fdn]
        tabb[B_FD_TY + nfields] = t
        tabw[W_FD_LEN + nfields] = cnt
        tabw[W_FD_OFF + nfields] = word(off)
        tabb[B_FD_HASDEF + nfields] = 0
        tabw[W_FD_DEFL + nfields] = 0
        tabw[W_FD_DEFH + nfields] = 0
        if n4[fdn] ~= 0 then
            if is_struct(t) or t == TY_STR or cnt ~= 0 then
                if fail_node(n4[fdn]) then msg("only number fields can have a default") end
                return
            end
            if not const_eval(n4[fdn]) then
                if fail_node(n4[fdn]) then msg("field defaults must be compile-time constants") end
                return
            end
            tabb[B_FD_HASDEF + nfields] = 1
            tabw[W_FD_DEFL + nfields] = word(cv)
            tabw[W_FD_DEFH + nfields] = word(cv >> 16)
        end
        tabw[W_ST_NF + k] += 1
        long c = long(cnt)
        if c == 0 then c = 1 end
        off += c * tstore(t)
        if off > 65535 then
            if fail_node(it) then msg("struct too large") end
            return
        end
        fdn = nx[fdn]
    end
    tabw[W_ST_SIZE + k] = word(off)
    nstructs += 1
end

-- a function (k = 255) or a method of struct k
function declare_func(word it, byte k)
    word f = new_sym(SK_FUNC, n1[it], TY_NONE)
    if f == 0 then return end
    sv2[f] = it
    byte np = 0
    if k ~= 255 then
        sstruct[f] = k + 1
        if field_find(k, n1[it]) ~= 0 then
            if fail_node(it) then
                msg("method `")
                msg_text(n1[it])
                msg("` has the same name as a field")
            end
            return
        end
        word ps = new_sym(SK_PARAM, 0, TY_STRUCT + k)     -- self
        sown[ps] = f
        sdead[ps] = 1
        np = 1
    end
    if n3[it] ~= 0 then
        byte r = type_of(n3[it])
        if r == TY_BAD then
            unsupported(it, "this return type")
            return
        end
        sty[f] = r
    end
    word p = n2[it]
    while p ~= 0 do
        byte pt = type_of(n2[p])
        if pt == TY_BAD then
            unsupported(p, "this parameter type")
            return
        end
        word ps = new_sym(SK_PARAM, n1[p], pt)
        sown[ps] = f
        sdead[ps] = 1
        np += 1
        p = nx[p]
    end
    snp[f] = np
end

-- ---------------------------------------------------------------- assets

const AK_PAT = 1            -- a PNG sheet of 16x16 patterns (converted: a_NAME.bin)
const AK_RAW = 2            -- the file as it is (.spr: patterns)
const AK_IMG = 3            -- a picture for Layer 2, in 8K pages
const AK_WAV = 4            -- a sample, in 8K pages
const MAXASSET = 64
byte nassets = 0
word far_arr_pages = 0      -- pages of far arrays (cleared at startup)
bool uses_samples = false
bool uses_notes = false
string apath = ""

function asset_err(word it, string m)
    if fail_node(it) then
        msg("`")
        msg(apath)
        msg("`: ")
        msg(m)
    end
end

function lc(byte c) -> byte
    if c >= 'A' and c <= 'Z' then return c + 32 end
    return c
end

-- the extension of apath, lower case, is e?
function ext_is(string e) -> bool
    byte n = len(apath)
    byte k = len(e)
    if n <= k then return false end
    if asc(apath, n - k - 1) ~= '.' then return false end
    byte i = 0
    while i < k do
        if lc(asc(apath, n - k + i)) ~= asc(e, i) then return false end
        i += 1
    end
    return true
end

function asset_pages(word it, byte a, word n) -> bool
    if word(next_page) + n > 224 then
        if fail_node(it) then msg("pictures and `far` arrays need more than the Next's 1 MB of memory") end
        return false
    end
    tabb[B_AS_PAGE + a] = next_page
    tabb[B_AS_NP + a] = byte(n)
    word i = 0
    while i < n do
        tabb[B_PASSET + (next_page + i)] = 1
        i += 1
    end
    next_page += byte(n)
    return true
end

-- `asset name = "file"` / `asset name = image("file.png")`: what the file
-- holds is read now (sizes); asset.nex converts it after this stage
function declare_asset(word it)
    word name = n1[it]
    if lookup(name) ~= 0 then
        if fail_node(it) then
            msg("`")
            msg_text(name)
            msg("` is already defined")
        end
        return
    end
    if nassets >= MAXASSET then
        if fail_node(it) then msg("too many assets") end
        return
    end
    word pt = n2[it]
    if tlen[pt] > 64 then
        if fail_node(it) then msg("the path of an asset can be at most 64 characters") end
        return
    end
    apath = ""
    word i = 0
    while i < tlen[pt] do
        apath = apath .. chr(tpool[toff[pt] + i])
        i += 1
    end
    byte a = nassets
    tabw[W_AS_NAME + a] = name
    tabw[W_AS_PATH + a] = pt
    tabb[B_AS_NP + a] = 0
    tabw[W_AS_N + a] = 0
    tabw[W_AS_LENL + a] = 0
    tabw[W_AS_LENH + a] = 0
    if nf[it] == 0 and ext_is("pt3") then
        unsupported(it, "music assets (.pt3)")
        return
    end
    if not ai_open(apath) then
        asset_err(it, ai_err)
        return
    end
    if nf[it] ~= 0 then
        tabb[B_AS_KIND + a] = AK_IMG
        if png_header() then
            if ai_wid == 0 or ai_hgt == 0 or ai_wid > 256 or ai_hgt > 255 then
                ai_close()
                asset_err(it, "images can be at most 256x255 pixels")
                return
            end
            word rpp = 8192 / ai_wid
            if rpp > 255 then rpp = 255 end
            tabw[W_AS_W + a] = ai_wid
            tabw[W_AS_H + a] = ai_hgt
            tabb[B_AS_RPP + a] = byte(rpp)
            ai_close()
            if not asset_pages(it, a, (ai_hgt + rpp - 1) / rpp) then return end
        end
    elseif ext_is("wav") then
        tabb[B_AS_KIND + a] = AK_WAV
        if wav_header() then
            tabb[B_AS_PRESC + a] = ai_presc
            tabw[W_AS_LENL + a] = word(ai_len)
            tabw[W_AS_LENH + a] = word(ai_len >> 16)
            ai_close()
            if not asset_pages(it, a, word((ai_len + 8191) / 8192)) then return end
        end
    elseif ext_is("png") then
        tabb[B_AS_KIND + a] = AK_PAT
        if png_header() then
            if ai_wid == 0 or ai_hgt == 0 or ai_wid % 16 ~= 0 or ai_hgt % 16 ~= 0 then
                ai_close()
                asset_err(it, "sheets of patterns must be multiples of 16x16 pixels")
                return
            end
            long n = long(ai_wid / 16) * long(ai_hgt / 16)
            if n > 64 then
                ai_close()
                asset_err(it, "more than the 64 8-bit patterns the Next holds")
                return
            end
            tabw[W_AS_N + a] = word(n)
            tabw[W_AS_LENL + a] = word(n) * 256
        end
    else
        tabb[B_AS_KIND + a] = AK_RAW
        long size = file_size(ai_fh)
        if size > 32768 then
            ai_close()
            asset_err(it, "too large for the program's memory")
            return
        end
        tabw[W_AS_LENL + a] = word(size)
        if ext_is("spr") then
            if size == 0 or size % 256 ~= 0 then
                ai_close()
                asset_err(it, ".spr size must be a multiple of 256 bytes")
                return
            end
            tabw[W_AS_N + a] = word(size / 256)
        end
    end
    ai_close()
    if ai_bad then
        asset_err(it, ai_err)
        return
    end
    word s = new_sym(SK_ASSET, name, TY_NONE)
    sid[s] = a
    nassets += 1
end

-- the asset named by expression e, of the kind k (AK_PAT also takes a
-- .spr), 255 if it is none
function asset_arg(word e, byte k) -> byte
    if nk[e] ~= E_NAME then return 255 end
    word s = lookup(n1[e])
    if s == 0 or sk[s] ~= SK_ASSET then return 255 end
    byte a = byte(sid[s])
    if tabb[B_AS_KIND + a] == k then return a end
    if k == AK_PAT and tabb[B_AS_KIND + a] == AK_RAW and tabw[W_AS_N + a] ~= 0 then return a end
    return 255
end

function o_asset(byte a)
    os("a_")
    otok(tabw[W_AS_NAME + a])
end

function odec32(long v)
    dec32(word(v >> 16), word(v))
    while ndig > 0 do
        ndig -= 1
        ob(digits[ndig])
    end
end

-- the descriptors and resident data of the assets
function asset_data()
    byte a = 0
    while a < nassets do
        o_asset(a)
        os(":\n")
        byte k = tabb[B_AS_KIND + a]
        if k == AK_PAT then
            os("    incbin \"")
            o_asset(a)
            os(".bin\"\n")
        elseif k == AK_RAW then
            os("    incbin \"")
            otok(tabw[W_AS_PATH + a])
            os("\"\n")
        elseif k == AK_IMG then
            os("    db ")
            odec(tabb[B_AS_PAGE + a])
            os("\n    dw ")
            odec(tabw[W_AS_W + a])
            os("\n    db ")
            odec(tabw[W_AS_H + a])
            ob(',')
            odec(tabb[B_AS_RPP + a])
            os("\n    incbin \"")
            o_asset(a)
            os(".msk\"\n")
        else
            os("    db ")
            odec(tabb[B_AS_PAGE + a])
            ob(',')
            odec(tabb[B_AS_PRESC + a])
            os("\n    dw ")
            odec(tabw[W_AS_LENL + a])
            os("\n    db ")
            odec(tabw[W_AS_LENH + a] & 255)
            onl()
        end
        a += 1
    end
end

-- the 8K pages of the pictures and samples
function asset_pages_out()
    byte a = 0
    while a < nassets do
        byte k = tabb[B_AS_KIND + a]
        if k == AK_IMG or k == AK_WAV then
            long total = long(tabw[W_AS_LENH + a]) << 16 | long(tabw[W_AS_LENL + a])
            long per = 8192
            if k == AK_IMG then
                total = long(tabw[W_AS_W + a]) * tabw[W_AS_H + a]
                per = long(tabw[W_AS_W + a]) * tabb[B_AS_RPP + a]
            end
            byte i = 0
            while i < tabb[B_AS_NP + a] do
                long off = long(i) * per
                long n = total - off
                if n > per then n = per end
                if k == AK_IMG then os("; picture ") else os("; sample ") end
                otok(tabw[W_AS_NAME + a])
                os("\n    MMU 1 e, ")
                odec(tabb[B_AS_PAGE + a] + i)
                os("\n    ORG $2000\n    incbin \"")
                o_asset(a)
                os(".bin\", ")
                odec32(off)
                os(", ")
                odec32(n)
                onl()
                i += 1
            end
        end
        a += 1
    end
end

-- assets.lst for the asset stage: true if there is something to convert
function asset_list() -> bool
    bool any = false
    byte a = 0
    while a < nassets do
        if tabb[B_AS_KIND + a] ~= AK_RAW then any = true end
        a += 1
    end
    if not any then
        if file_exists("assets.lst") then file_delete("assets.lst") end
        return false
    end
    byte h = file_open("assets.lst", FILE_WRITE)
    if h == FILE_ERROR then return false end
    to_file(h)
    a = 0
    while a < nassets do
        byte k = tabb[B_AS_KIND + a]
        if k ~= AK_RAW then
            if k == AK_PAT then
                ob('p')
            elseif k == AK_IMG then
                ob('i')
            else
                ob('w')
            end
            ob(' ')
            otok(tabw[W_AS_NAME + a])
            ob(' ')
            otok(tabw[W_AS_PATH + a])
            onl()
        end
        a += 1
    end
    to_file(0)
    file_close(h)
    return true
end

-- ---- call graph (for recursion)

const MAXEDGE = 4000
far word eto[4000]          -- callee symbol
far word enext[4000]        -- next edge of the same caller
far word efirst[8000]       -- first edge of a function symbol
word nedge = 0
word seen_mark = 0
far word seen_at[8000]

-- record the calls in the subtree of node n (a function's body) for f
function add_edge(word f, word c)
    if nedge >= MAXEDGE - 1 then return end
    nedge += 1
    eto[nedge] = c
    enext[nedge] = efirst[f]
    efirst[f] = nedge
end

-- record the calls in the subtree of node n (a function's body) for f
-- (a method call: every method of that name; a constructor: its init)
function collect_calls(word f, word n)
    while n ~= 0 do
        byte k = nk[n]
        if k == E_CALL then
            word c = lookup(n1[n])
            if c ~= 0 and sk[c] == SK_FUNC then
                add_edge(f, c)
            elseif c == 0 then
                byte st = struct_by_name(n1[n])
                if st ~= 255 and tabw[W_ST_INIT + st] ~= 0 then add_edge(f, tabw[W_ST_INIT + st]) end
            end
        elseif k == E_METHOD then
            word m = shead[toff[n2[n]] & 1023]
            while m ~= 0 do
                if sk[m] == SK_FUNC and sstruct[m] ~= 0 and toff[sname[m]] == toff[n2[n]] then add_edge(f, m) end
                m = snext[m]
            end
        end
        if k == E_INDEX or k == E_BINARY then
            collect_calls(f, n1[n])
            collect_calls(f, n2[n])
        elseif k == E_FIELD or k == E_UNARY or k == E_LIST or k == S_FAR or k == S_RETURN or k == S_EXPR then
            collect_calls(f, n1[n])
        elseif k == E_CALL then
            collect_calls(f, n2[n])
        elseif k == E_METHOD then
            collect_calls(f, n1[n])
            collect_calls(f, n3[n])
        elseif k == S_VAR then
            collect_calls(f, n3[n])
            collect_calls(f, n4[n])
        elseif k == S_ASSIGN or k == S_WHILE or k == S_ARM or k == S_IF then
            collect_calls(f, n1[n])
            collect_calls(f, n2[n])
        elseif k == S_FOR then
            collect_calls(f, n2[n])
            collect_calls(f, n3[n])
            collect_calls(f, n4[n])
        end
        n = nx[n]
    end
end

-- can a call to `from` lead to a call of `target`?
far word stack_[3000]
function reaches(word from, word target) -> bool
    seen_mark += 1
    word sp_ = 0
    stack_[sp_] = from
    sp_ += 1
    while sp_ > 0 do
        sp_ -= 1
        word f = stack_[sp_]
        if f == target then return true end
        if seen_at[f] ~= seen_mark then
            seen_at[f] = seen_mark
            word ed = efirst[f]
            while ed ~= 0 do
                if sp_ < 2999 then
                    stack_[sp_] = eto[ed]
                    sp_ += 1
                end
                ed = enext[ed]
            end
        end
    end
    return false
end

-- symbol s has storage in a function's frame
function in_frame(word s) -> bool
    byte k = sk[s]
    return (k == SK_PARAM or k == SK_LOCAL) and sown[s] ~= 0
end

-- frame label of function f: `fr_name` / `fr_name_end`
function ofr(word f, bool at_end)
    os("fr_")
    o_fnname(f)
    if at_end then os("_end") end
end

function o_frame_size(string ins)
    os("    ")
    os(ins)
    ofr(cur_fn, true)
    ob('-')
    ofr(cur_fn, false)
    onl()
end

-- arguments into the parameter slots (through the stack, so an argument
-- may call the same function), then the call. A call that can come back
-- to the current function saves its frame (parameters and locals) on the
-- stack around the call.
function call_func(word e, word f, word alist)
    bool save = cur_fn ~= 0 and reaches(f, cur_fn)
    if not save then
        call_args(e, f, alist)
        return
    end
    os("    ld hl,")
    ofr(cur_fn, false)
    ob('-')
    ofr(cur_fn, true)
    onl()
    oi("add hl,sp")
    oi("ld sp,hl")
    oi("ex de,hl")
    os("    ld hl,")
    ofr(cur_fn, false)
    onl()
    o_frame_size("ld bc,")
    oi("ld a,b")
    oi("or c")
    word nz = new_label()
    jp("jr z,", nz)
    oi("ldir")
    label(nz)
    call_args(e, f, alist)
    oi("ld (sh_ret),hl")
    oi("ld (sh_ret+2),de")
    oi("ld (sh_reta),a")
    oi("ld hl,0")
    oi("add hl,sp")
    os("    ld de,")
    ofr(cur_fn, false)
    onl()
    o_frame_size("ld bc,")
    oi("ld a,b")
    oi("or c")
    word nz2 = new_label()
    jp("jr z,", nz2)
    oi("ldir")
    label(nz2)
    oi("ld sp,hl")          -- HL = the first byte after the saved frame
    oi("ld hl,(sh_ret)")
    oi("ld de,(sh_ret+2)")
    oi("ld a,(sh_reta)")
end

function call_args(word e, word f, word alist)
    byte kind = ps_kind
    word sv = ps_val
    ps_kind = 0
    byte np = snp[f]
    byte given = count(alist)
    byte shown = np
    if kind ~= 0 then
        given += 1
        shown -= 1
    end
    if given ~= np then
        if fail_node(e) then
            msg("`")
            msg_text(sname[f])
            msg("` expects ")
            msg_dec(0, shown)
            msg(" argument(s)")
        end
        return
    end
    byte i = 0
    if kind ~= 0 then
        if kind == 1 then
            gen_struct_arg(sv, sty[f + 1])
        elseif kind == 2 then
            o_ins_lab("ld hl,(", cur_fn + 1, ")")
        else
            o_ins_lab("ld hl,(", sv, ")")
        end
        oi("push hl")
        i = 1
    end
    word a = alist
    while a ~= 0 and not failed do
        word p = f + 1 + i
        byte pt = sty[p]
        if is_struct(pt) then
            gen_struct_arg(a, pt)
            oi("push hl")
        elseif pt == TY_STR then
            gen_str(a)
            oi("push hl")
        else
            gen_for(a, pt)
            push_val(pt)
        end
        a = nx[a]
        i += 1
    end
    if failed then return end
    while i > 0 do
        i -= 1
        word p = f + 1 + i
        oi("pop hl")
        if sty[p] ~= TY_STR and not is_struct(sty[p]) and tsize(sty[p]) == 4 then oi("pop de") end
        store_sym(p)
    end
    o_ins_lab("call ", f, "")
end

-- ---------------------------------------------------------------- code: statements

const MAXLOOP = 32
word loop_end[32]
byte nloop = 0

-- statements of a block, in a new scope
function cg_block(word first)
    word mark = nsy
    word s = first
    while s ~= 0 and not failed do
        cg_stmt(s)
        s = nx[s]
    end
    -- named locals of this block go out of scope (they keep their storage)
    word k = nsy
    while k > mark do
        sdead[k] = 1
        k -= 1
    end
end

bool pass_declare = false
byte next_page = 28         -- next free 8K page (far arrays, code pages)
byte first_page = 28        -- the first of them

-- string variable s = value
function assign_str_sym(word s, word value)
    gen_str(value)
    if sk[s] == SK_PARAM then
        o_ins_lab("ld de,(", s, ")")
    else
        o_ins_lab("ld de,", s, "")
    end
    oi("call rt_scopy")
end

-- declare a variable (global at the top level of the main program)
function declare_var(word s, bool top, bool far_)
    word name = n2[s]
    word init = n4[s]
    if nf[s] ~= 0 then
        -- const: the value at compile time
        if nk[init] == E_STR then
            unsupported(s, "string constants")
            return
        end
        if not const_eval(init) then
            if fail_node(s) then msg("a constant needs a compile-time value") end
            return
        end
        if top and lookup(name) ~= 0 then return end   -- declared by the first pass
        word c = new_sym(SK_CONST, name, TY_NONE)
        sid[c] = word(cv)
        sv2[c] = word(cv >> 16)
        return
    end
    byte ty = TY_NONE
    if n1[s] ~= 0 then
        ty = type_of(n1[s])
        if ty == TY_BAD then
            unsupported(s, "this type")
            return
        end
    else
        ty = nat(init)
        if ty == TY_NONE then
            if const_eval(init) then ty = lit_ty(cv) else ty = TY_WORD end
        end
    end
    word v = 0
    if top and not pass_declare then v = lookup(name) end
    if v == 0 then
        if top then
            v = new_sym(SK_GLOBAL, name, ty)
        else
            v = new_local(name, ty)
        end
        word size = n3[s]
        if size ~= 0 then
            if nk[size] == E_LIST then
                if n1[size] ~= 0 then
                    unsupported(s, "arrays of more than one dimension")
                    return
                end
                -- `[]`: the size of the list
                if init == 0 or nk[init] ~= E_LIST then return end
                slen[v] = count(n1[init])
            else
                if not const_eval(size) or cv < 1 or cv > 65535 then
                    if fail_node(size) then msg("an array size must be a constant 1..65535") end
                    return
                end
                slen[v] = word(cv)
            end
        end
        if far_ then
            long bytes = long(slen[v]) * tstore(ty)
            byte pages = byte((bytes + 8191) / 8192)
            bool defs = is_struct(ty) and has_defaults(ty - TY_STRUCT)
            if init ~= 0 or ty == TY_STR or bytes > 65536 or defs then
                unsupported(s, "this far array")
                return
            end
            spage[v] = next_page
            next_page += pages
            far_arr_pages += pages
        end
    end
    if pass_declare then return end
    if is_struct(ty) then
        if spage[v] == 0 then declare_struct_var(v, init) end
        return
    end
    if slen[v] ~= 0 then
        if init == 0 then return end
        if sk[v] == SK_GLOBAL and ty ~= TY_STR then
            sv2[v] = init       -- emitted as data
            return
        end
        -- a local array or a string array: store the values
        word item = n1[init]
        word i = 0
        while item ~= 0 and not failed do
            if ty == TY_STR then
                gen_str(item)
                oi("push hl")
                load_const(i, 2, false)
                oi("ld de,65")
                oi("call rt_mul16")
                o_ins_lab("ld de,", v, "")
                oi("add hl,de")
                oi("ex de,hl")
                oi("pop hl")
                oi("call rt_scopy")
            else
                gen_for(item, ty)
                push_val(ty)
                load_const(i, 2, false)
                if tsize(ty) == 2 then oi("add hl,hl") end
                if tsize(ty) == 4 then
                    oi("add hl,hl")
                    oi("add hl,hl")
                end
                o_ins_lab("ld de,", v, "")
                oi("add hl,de")
                store_at_hl(ty)
            end
            item = nx[item]
            i += 1
        end
        return
    end
    if ty == TY_STR then
        if sk[v] == SK_LOCAL then
            oi("xor a")
            o_ins_lab("ld (", v, "),a")
        end
        if init ~= 0 then assign_str_sym(v, init) end
        return
    end
    if init ~= 0 then
        if nk[init] == E_LIST then
            if fail_node(init) then msg("a list for a variable that is not a struct or an array") end
            return
        end
        gen_for(init, ty)
        store_sym(v)
    elseif sk[v] == SK_LOCAL then
        load_const(0, tsize(ty), false)
        store_sym(v)
    end
end

function assign(word s)
    word target = n1[s]
    word value = n2[s]
    byte op = nf[s]
    byte k = nk[target]
    if k == E_INDEX then
        byte hw = is_hw(target)
        if hw >= 2 then
            byte o = 255
            if op ~= 0 then o = op - 1 end
            gen_hw_write(target, value, hw, o)
            return
        end
    end
    if k ~= E_NAME and k ~= E_INDEX and k ~= E_FIELD then
        unsupported(s, "assigning to this")
        return
    end
    if k == E_NAME and not is_self(n1[target]) then
        word v = var_sym(target, n1[target])
        if v == 0 then return end
        if sk[v] == SK_CONST or slen[v] ~= 0 then
            if fail_node(s) then msg("cannot assign to this") end
            return
        end
        if sty[v] ~= TY_STR and not is_struct(sty[v]) then
            byte t = ctx_ty(sty[v], value)
            if op == 0 then
                gen(value, tsize(t), tsigned(t))
            else
                gen_op_assign(op - 1, target, value, sty[v])
            end
            store_sym(v)
            return
        end
    end
    if not place_type(target) then
        gen_place(target)       -- reports what is wrong
        if not failed and fail_node(s) then msg("cannot assign to this") end
        return
    end
    byte ety = pt_ty
    if pt_len ~= 0 then
        if fail_node(s) then msg("cannot assign to a whole array") end
        return
    end
    if (ety == TY_STR or is_struct(ety)) and op ~= 0 then
        if fail_node(s) then msg("this takes `=` only") end
        return
    end
    if ety == TY_STR then
        gen_str(value)
        oi("push hl")
        gen_place(target)
        oi("ex de,hl")
        oi("pop hl")
        oi("call rt_scopy")
        return
    end
    if is_struct(ety) then
        if nk[value] == E_LIST or is_ctor(value) then
            -- built aside first: the value may read the target (`v = {v.y, v.x}`)
            word tmp = new_local(0, ety)
            sdead[tmp] = 1
            o_ins_lab("ld hl,", tmp, "")
            struct_into_hl(ety, value)
            gen_place(target)
            oi("ex de,hl")
            o_ins_lab("ld hl,", tmp, "")
            o_ldir(tabw[W_ST_SIZE + (ety - TY_STRUCT)])
            return
        end
        gen_place(target)
        struct_into_hl(ety, value)
        return
    end
    if op == 0 then
        gen_for(value, ety)
    else
        gen_op_assign(op - 1, target, value, ety)
    end
    push_val(ety)
    gen_place(target)
    store_at_hl(ety)
end

-- target op= value: the new value in HL (DE:HL)
function gen_op_assign(byte op, word target, word value, byte ty)
    byte t = join(ty, nat(value))
    if t == TY_NONE or t == TY_BOOL then t = ty end
    gen_arith(op, target, value, tsize(t), tsigned(t))
end

-- condition false -> jump to label n
function branch_false(word cond, word n)
    gen(cond, 1, false)
    oi("ld a,l")
    oi("or a")
    jp("jp z,", n)
end

function cg_if(word s)
    word done = new_label()
    word arm = n1[s]
    while arm ~= 0 and not failed do
        word next_arm = new_label()
        branch_false(n1[arm], next_arm)
        cg_block(n2[arm])
        jp("jp ", done)
        label(next_arm)
        arm = nx[arm]
    end
    if nf[s] ~= 0 then cg_block(n2[s]) end
    label(done)
end

function while_stmt(word s)
    word top = new_label()
    word done = new_label()
    label(top)
    branch_false(n1[s], done)
    loop_end[nloop] = done
    nloop += 1
    cg_block(n2[s])
    nloop -= 1
    jp("jp ", top)
    label(done)
end

-- HL = v, DE = e: flags of v - e (signed: sign bits flipped first)
function cmp_hl_de(bool sg)
    if sg then
        oi("ld a,d")
        oi("xor $80")
        oi("ld d,a")
        oi("ld a,h")
        oi("xor $80")
        oi("ld h,a")
    end
    oi("or a")
    oi("sbc hl,de")
end

function for_stmt(word s)
    word holder = n4[s]
    word stepn = n1[holder]
    long step = 1
    if stepn ~= 0 then
        if not const_eval(stepn) or cv == 0 then
            if fail_node(stepn) then msg("the step of a `for` must be a nonzero constant") end
            return
        end
        step = cv
    end
    byte t = join(nat(n2[s]), nat(n3[s]))
    if t == TY_NONE then
        t = TY_BYTE
        if const_eval(n2[s]) then t = lit_ty(cv) end
        if const_eval(n3[s]) then t = join(t, lit_ty(cv)) end
    end
    if t == TY_BOOL then t = TY_BYTE end
    if t == TY_LONG or t == TY_STR then
        unsupported(s, "a `for` over this type")
        return
    end
    bool sg = tsigned(t)
    word mark = nsy
    -- the loop variable and the end value (a hidden local)
    word v = new_local(n1[s], t)
    word ev = new_local(0, t)
    sdead[ev] = 1
    gen(n2[s], tsize(t), sg)
    store_sym(v)
    gen(n3[s], tsize(t), sg)
    store_sym(ev)
    word body = new_label()
    word done = new_label()
    -- not even once?
    load_sym(ev)
    oi("push hl")
    load_sym(v)
    oi("pop de")
    cmp_hl_de(sg)           -- v - end
    if step > 0 then
        word ok = new_label()
        jp("jr z,", ok)
        jp("jp nc,", done)  -- v > end
        label(ok)
    else
        jp("jp c,", done)   -- v < end
    end
    label(body)
    loop_end[nloop] = done
    nloop += 1
    cg_block(n2[holder])
    nloop -= 1
    -- the distance to the end, then the step
    long astep = step
    if step < 0 then astep = 0 - step end
    if step > 0 then
        load_sym(v)
        oi("push hl")
        load_sym(ev)        -- HL = end, DE = v
    else
        load_sym(ev)
        oi("push hl")
        load_sym(v)         -- HL = v, DE = end
    end
    oi("pop de")
    oi("or a")
    oi("sbc hl,de")         -- distance (unsigned)
    os("    ld de,")
    odec(word(astep))
    onl()
    oi("or a")
    oi("sbc hl,de")         -- distance - step
    jp("jp c,", done)
    load_sym(v)
    os("    ld de,")
    odec(word(step))
    onl()
    oi("add hl,de")
    store_sym(v)
    jp("jp ", body)
    label(done)
    word k = nsy
    while k > mark do
        sdead[k] = 1
        k -= 1
    end
end

-- print / write
function print_stmt(word e, bool newline)
    word a = n2[e]
    bool first = true
    while a ~= 0 and not failed do
        if newline and not first then oi("call rt_space") end
        first = false
        byte t = nat(a)
        if nk[a] == E_STR then
            word l = str_label(n1[a])
            os("    ld hl,s_")
            odec(l)
            onl()
            oi("call rt_print_str")
        elseif t == TY_STR then
            gen_str(a)
            oi("call rt_print_pstr")
        elseif t == TY_BOOL then
            gen(a, 1, false)
            oi("ld a,l")
            oi("call rt_print_bool")
        else
            if t == TY_NONE then
                if const_eval(a) then t = lit_ty(cv) else t = TY_WORD end
            end
            gen(a, tsize(t), tsigned(t))
            if t == TY_LONG then
                oi("call rt_print_s32")
            elseif tsigned(t) then
                oi("call rt_print_s16")
            else
                oi("call rt_print_u16")
            end
        end
        a = nx[a]
    end
    if newline then oi("call rt_newline") end
end

function call_stmt(word e)
    if nk[e] == E_METHOD then
        gen_method_call(e)
        return
    end
    word name = n1[e]
    if text_is(name, "print") then
        print_stmt(e, true)
        return
    end
    if text_is(name, "write") then
        print_stmt(e, false)
        return
    end
    word f = lookup(name)
    if f ~= 0 and sk[f] == SK_FUNC then
        call_func(e, f, n2[e])
        return
    end
    if builtin_stmt(e) then return end
    if builtin_expr(e, 2) then return end
    if fail_node(e) then
        msg("not supported by the self-hosted compiler yet: function `")
        msg_text(name)
        msg("`")
    end
end

function cg_stmt(word s)
    byte k = nk[s]
    if k == S_VAR then
        declare_var(s, false, false)
    elseif k == S_ASSIGN then
        assign(s)
    elseif k == S_IF then
        cg_if(s)
    elseif k == S_WHILE then
        while_stmt(s)
    elseif k == S_FOR then
        for_stmt(s)
    elseif k == S_BREAK then
        if nloop == 0 then
            if fail_node(s) then msg("`break` outside a loop") end
            return
        end
        jp("jp ", loop_end[nloop - 1])
    elseif k == S_RETURN then
        if cur_fn == 0 then
            oi("jp __main_end")
            return
        end
        byte r = sty[cur_fn]
        if n1[s] ~= 0 then
            if r == TY_NONE then
                if fail_node(s) then msg("this function returns no value") end
                return
            end
            if r == TY_STR then
                gen_str(n1[s])
                o_ret("ld de,", cur_fn)
                oi("call rt_scopy")
                o_ret("ld hl,", cur_fn)
            elseif is_struct(r) then
                o_ret("ld hl,", cur_fn)
                struct_into_hl(r, n1[s])
                o_ret("ld hl,", cur_fn)
            else
                gen_for(n1[s], r)
                if tsize(r) == 1 then oi("ld a,l") end
            end
        end
        oi("ret")
    elseif k == S_EXPR then
        call_stmt(n1[s])
    elseif k == S_ASM then
        -- the body, verbatim (each line ends with a newline)
        word t = n1[s]
        word i = 0
        word o = toff[t]
        while i < tlen[t] do
            ob(tpool[o + i])
            i += 1
        end
    elseif k == S_FAR then
        if cur_fn ~= 0 then
            if fail_node(s) then msg("`far` arrays are declared at the top level") end
        end
        -- declared in the first pass
    elseif k == S_ASSET then
        if fail_node(s) then msg("`asset` declarations must be at the top level") end
    else
        unsupported(s, "this statement")
    end
end

-- ---------------------------------------------------------------- program

function set_params(word f, byte dead)
    word i = 1
    while i <= snp[f] do
        sdead[f + i] = dead
        i += 1
    end
end

-- first pass: functions, globals and constants (usable before their place)
function declare_all()
    pass_declare = true
    -- the struct types first (usable by everything else), with the
    -- constants their sizes may use
    word it = prog_first
    while it ~= 0 and not failed do
        if nk[it] == I_STRUCT then declare_struct(it) end
        if nk[it] == S_VAR and nf[it] ~= 0 and nk[n4[it]] ~= E_STR and const_eval(n4[it]) then declare_var(it, true, false) end
        it = nx[it]
    end
    it = prog_first
    while it ~= 0 and not failed do
        byte k = nk[it]
        if k == I_FUNC then
            declare_func(it, 255)
        elseif k == I_STRUCT then
            byte st = struct_by_name(n1[it])
            word m = n4[it]
            while m ~= 0 and not failed do
                declare_func(m, st)
                m = nx[m]
            end
        elseif k == S_VAR then
            declare_var(it, true, false)
        elseif k == S_FAR then
            declare_var(n1[it], true, true)
        elseif k == I_INTERRUPT then
            unsupported(it, "interrupts")
        elseif k == S_ASSET then
            declare_asset(it)
        end
        it = nx[it]
    end
    if failed then return end
    -- the init method of each class (its own, else its parent's)
    word m = 1
    while m <= nsy do
        if sk[m] == SK_FUNC and sstruct[m] ~= 0 and text_is(sname[m], "init") then tabw[W_ST_INIT + (sstruct[m] - 1)] = m end
        m += 1
    end
    byte c = 0
    while c < nstructs do
        byte q = c
        while tabw[W_ST_INIT + q] == 0 and tabb[B_ST_PARENT + q] ~= 255 do q = tabb[B_ST_PARENT + q] end
        tabw[W_ST_INIT + c] = tabw[W_ST_INIT + q]
        c += 1
    end
    -- the call graph
    word f = 1
    while f <= nsy do
        if sk[f] == SK_FUNC then
            set_params(f, 0)
            cur_fn = f
            collect_calls(f, n4[sv2[f]])
            cur_fn = 0
            set_params(f, 1)
        end
        f += 1
    end
    pass_declare = false
end

-- ---- code banking

const RESIDENT_LIMIT = 30500
const RUNTIME_SIZE = 3600   -- startup + runtime + font (measured: 3263)
const LONG_SIZE = 1100      -- the 32-bit routines (measured: about 1000)
const PAGE_CAP = 7600
byte cur_page = 0           -- code page being filled (0 = none)
long page_used = 0

-- estimated bytes of the data of the globals (first pass)
function global_data() -> word
    word total = 0
    word s = 1
    while s <= nsy do
        if sk[s] == SK_GLOBAL and spage[s] == 0 then
            word n = slen[s]
            if n == 0 then n = 1 end
            total += n * tstore(sty[s])
        end
        if sk[s] == SK_PARAM then
            if sty[s] == TY_STR or is_struct(sty[s]) then total += 2 else total += tsize(sty[s]) end
        end
        if sk[s] == SK_FUNC and (sty[s] == TY_STR or is_struct(sty[s])) then total += tstore(sty[s]) end
        s += 1
    end
    byte k = 0
    while k < nstructs do
        total += tabw[W_ST_SIZE + k]
        k += 1
    end
    k = 0
    while k < nassets do
        total += tabw[W_AS_LENL + k] + 6
        if tabb[B_AS_KIND + k] == AK_WAV then total -= tabw[W_AS_LENL + k] end
        k += 1
    end
    return total
end

-- bytes of resident data the code will need besides the globals: locals,
-- loop variables, string temporaries and literals (from the whole tree,
-- before any function is placed; generous rather than short)
function data_reserve() -> long
    -- top-level declarations (globals: counted apart; far data is paged)
    -- are marked with bit 1 of nf for the time of the count
    word it = prog_first
    while it ~= 0 do
        if nk[it] == S_VAR then nf[it] = nf[it] | 2 end
        if nk[it] == S_FAR then nf[n1[it]] = nf[n1[it]] | 2 end
        it = nx[it]
    end
    long total = 0
    word n = 1
    while n <= nnodes do
        byte k = nk[n]
        if k == S_VAR and nf[n] == 0 then
            byte t = TY_WORD
            if n1[n] ~= 0 then t = type_of(n1[n]) end
            if t == TY_BAD then t = TY_WORD end
            long cnt = 1
            word size = n3[n]
            if size ~= 0 then
                if nk[size] == E_LIST then
                    if n4[n] ~= 0 and nk[n4[n]] == E_LIST then cnt = count(n1[n4[n]]) end
                elseif const_eval(size) then
                    cnt = cv
                end
            end
            total += cnt * tstore(t)
        elseif k == S_FOR then
            total += 4
        elseif k == E_BINARY and nf[n] == B_CONCAT then
            total += 65
        elseif k == E_CALL and (text_is(n1[n], "chr") or text_is(n1[n], "str")) then
            total += 65
        elseif k == E_CALL and struct_by_name(n1[n]) ~= 255 then
            total += tabw[W_ST_SIZE + (struct_by_name(n1[n]))] + 2
        elseif k == E_LIST then
            total += 2
        elseif k == E_STR then
            total += tlen[n1[n]] + 2
        end
        n += 1
    end
    it = prog_first
    while it ~= 0 do
        if nk[it] == S_VAR then nf[it] = nf[it] & 1 end
        if nk[it] == S_FAR then nf[n1[it]] = nf[n1[it]] & 1 end
        it = nx[it]
    end
    return total
end

-- the code of one function: into fn.tmp, then resident or into a code page
function gen_function(word f)
    word node_ = sv2[f]
    to_file(0)
    byte tmp = file_open("fn.tmp", FILE_WRITE)
    to_file(tmp)
    cur_fn = f
    set_params(f, 0)
    long cost0 = cost_out
    cg_block(n4[node_])
    oi("ret")
    set_params(f, 1)
    cur_fn = 0
    long est = cost_out - cost0 + 16
    to_file(outh)
    file_close(tmp)
    if failed then return end
    bool bank = resident_used + est > RESIDENT_LIMIT
    os("; function ")
    otok(sname[f])
    onl()
    if not bank then
        resident_used += est
        olab(f)
        os(":\n")
        ocopy("fn.tmp")
        onl()
        return
    end
    -- a stub here, the code in a page
    if est > PAGE_CAP then
        if fail_node(node_) then msg("function too large for one 8K code page") end
        return
    end
    if cur_page == 0 or page_used + est > PAGE_CAP then
        cur_page = next_page
        next_page += 1
        page_used = 0
        to_file(bankh)
        os("; code page ")
        odec(cur_page)
        os("\n    MMU 2 e, ")
        odec(cur_page)
        os("\n    ORG $4000\n")
        to_file(outh)
    end
    page_used += est
    sbank[f] = cur_page
    resident_used += 8
    olab(f)
    os(":\n")
    o_ins_lab("ld hl,", f, "_bank")
    os("    ld a,")
    odec(cur_page)
    onl()
    oi("jp rt_bcall")
    to_file(bankh)
    olab(f)
    os("_bank:\n")
    ocopy("fn.tmp")
    onl()
    to_file(outh)
end

-- the data of one symbol
function data_sym(word s)
    byte k = sk[s]
    if k ~= SK_GLOBAL and k ~= SK_PARAM and k ~= SK_LOCAL then return end
    if spage[s] ~= 0 then return end
    olab(s)
    word n = slen[s]
    if n == 0 then n = 1 end
    word init = 0
    if k == SK_GLOBAL and slen[s] ~= 0 and sty[s] ~= TY_STR and not is_struct(sty[s]) then init = sv2[s] end
    word esz = tstore(sty[s])
    if is_ref_param(s) then esz = 2 end
    if init == 0 then
        os(": ds ")
        odec(n * esz)
        onl()
        return
    end
    -- initialised global array
    if esz == 4 then
        os(": dd ")
    elseif esz == 2 then
        os(": dw ")
    else
        os(": db ")
    end
    word item = n1[init]
    word i = 0
    while i < n do
        if i > 0 then ob(',') end
        long v = 0
        if item ~= 0 then
            if not const_eval(item) then
                if fail_node(item) then msg("an array initializer must be constant") end
                return
            end
            v = cv
            item = nx[item]
        end
        if esz == 4 then
            if v < 0 then
                ob('-')
                v = 0 - v
            end
            dec32(word(v >> 16), word(v))
            while ndig > 0 do
                ndig -= 1
                ob(digits[ndig])
            end
        elseif esz == 2 then
            odec(word(v))
        else
            odec(word(v) & 255)
        end
        i += 1
    end
    onl()
end

function out_literal(word t)
    word j = 0
    while j < tlen[t] do
        if j > 0 then ob(',') end
        odec(tpool[toff[t] + j])
        j += 1
    end
end

-- does the program use the 320x256 / 640x256 mode (Layer 2 320x256 / 640x256 buffers take
-- the pages up to 35)?
function uses_l2_hires() -> bool
    word t = 1
    while t < ntok do
        if tk[t] == T_IDENT and text_isx(t, "l|ayer2_mode") then return true end
        t += 1
    end
    return false
end

long est_globals = 0
long est_reserve = 0

function generate()
    if uses_l2_hires() then next_page = 36 end
    first_page = next_page
    declare_all()
    if failed then return end
    est_globals = global_data()
    est_reserve = data_reserve()
    resident_used = RUNTIME_SIZE + LONG_SIZE + est_globals + est_reserve + 500
    -- the runtime parts for pictures (measured: about 450 bytes), samples
    -- (390) and notes (240)
    byte ka = 0
    bool img_ = false
    bool wav_ = false
    while ka < nassets do
        if tabb[B_AS_KIND + ka] == AK_IMG then img_ = true end
        if tabb[B_AS_KIND + ka] == AK_WAV then wav_ = true end
        ka += 1
    end
    if img_ then resident_used += 500 end
    if wav_ then resident_used += 450 end
    word tn = 1
    while tn < ntok do
        if tk[tn] == T_IDENT and text_is(tn, "note_period") then
            resident_used += 260
            break
        end
        tn += 1
    end
    to_file(outh)
    os("; Generated by codegen.lz80n (self-hosted LZ80N compiler)\n")
    oi("OPT --zxnext")
    oi("DEVICE ZXSPECTRUMNEXT")
    oi("ORG $8000")
    onl()
    ocopy("rt_start.asm")
    oi("ei")
    os("\n; ---- main program ----\n")
    if far_arr_pages > 0 then oi("call rt_far_zero") end
    long cost0 = cost_out
    word it = prog_first
    while it ~= 0 and not failed do
        byte k = nk[it]
        if k == S_VAR then
            declare_var(it, true, false)
        elseif k ~= I_FUNC and k ~= I_STRUCT and k ~= S_ASSET then
            cg_stmt(it)
        end
        it = nx[it]
    end
    oi("jp __main_end")
    onl()
    resident_used += cost_out - cost0
    if resident_used > RESIDENT_LIMIT then
        if fail_at(0, 0) then
            msg("not supported by the self-hosted compiler yet: a main program this large (move code into functions); estimate: globals ")
            msg_dec(0, word(est_globals))
            msg(", other data ")
            msg_dec(0, word(est_reserve))
            msg(", main code ")
            msg_dec(0, word(cost_out - cost0))
        end
        return
    end
    byte far_end = next_page
    word f = 1
    while f <= nsy and not failed do
        if sk[f] == SK_FUNC then gen_function(f) end
        f += 1
    end
    if failed then return end
    if cur_page ~= 0 then ocopy("rt_banked.asm") end
    ocopy("rt_lib.asm")         -- starts with __main_end
    if uses_long then ocopy("rt_long.asm") end
    bool any_img = false
    byte ai = 0
    while ai < nassets do
        if tabb[B_AS_KIND + ai] == AK_IMG then any_img = true end
        ai += 1
    end
    if any_img then ocopy("rt_images.asm") end
    if uses_samples then ocopy("rt_samples.asm") end
    if uses_notes then ocopy("rt_notes.asm") end
    -- the background driver of the sound module
    word drv = 0
    word df = 1
    while df <= nsy do
        if sk[df] == SK_FUNC and sstruct[df] == 0 and text_isx(sname[df], "s|ound_tick") then drv = df end
        df += 1
    end
    -- slot 1 (far data, pictures) and the code page may be remapped by the
    -- drivers the handler calls
    bool slot1 = far_end > first_page
    bool banked = cur_page ~= 0
    os("\n; ---- interrupt service routine ----\n")
    os("__isr:\n    push af\n    push bc\n    push de\n    push hl\n")
    if slot1 then os("    ld a,(rt_farpage)\n    push af\n") end
    if banked then os("    ld a,(rt_codepage)\n    push af\n    ld a,(rt_bret)\n    push af\n") end
    os("    ld hl,(rt_frames)\n    inc hl\n    ld (rt_frames),hl\n")
    if drv ~= 0 then o_ins_lab("call ", drv, "") end
    if uses_samples then oi("call rt_smp_tick") end
    if banked then os("    pop af\n    ld (rt_bret),a\n    pop af\n    ld (rt_codepage),a\n    nextreg $52,a\n") end
    if slot1 then os("    pop af\n    ld (rt_farpage),a\n    nextreg $51,a\n") end
    os("    pop hl\n    pop de\n    pop bc\n    pop af\n    ei\n    reti\n")
    ocopy("rt_font.asm")
    if far_arr_pages > 0 then
        os("; clear the far pages at startup\nrt_far_zero:\n    ld hl,rt_far_zero_tab\n.p:\n    ld a,(hl)\n    or a\n    ret z\n")
        os("    push hl\n    ld (rt_farpage),a\n    nextreg $51,a\n    xor a\n    ld de,$2000\n    ld bc,8192\n")
        os("    call rt_dma_fill\n    pop hl\n    inc hl\n    jr .p\nrt_far_zero_tab: db ")
        byte p = first_page
        while p < far_end do
            if tabb[B_PASSET + p] == 0 then
                odec(p)
                ob(',')
            end
            p += 1
        end
        os("0\n")
    end
    os("\n; ---- data ----\n")
    word i = 0
    while i < nstrs do
        os("s_")
        odec(i)
        os(": db ")
        out_literal(strs[i])
        if tlen[strs[i]] > 0 then ob(',') end
        os("0\n")
        i += 1
    end
    i = 0
    while i < npstrs do
        os("ps_")
        odec(i)
        os(": db ")
        odec(tlen[pstrs[i]])
        if tlen[pstrs[i]] > 0 then ob(',') end
        out_literal(pstrs[i])
        onl()
        i += 1
    end
    os("sh_ret: ds 4\nsh_reta: db 0\n")
    -- the default images of the structs, the return buffers
    byte sk2 = 0
    while sk2 < nstructs do
        o_sd(sk2)
        os(":\n")
        out_image(sk2)
        sk2 += 1
    end
    asset_data()
    word rf = 1
    while rf <= nsy do
        if sk[rf] == SK_FUNC and (sty[rf] == TY_STR or is_struct(sty[rf])) then
            os("r_")
            o_fnname(rf)
            os(": ds ")
            odec(tstore(sty[rf]))
            onl()
        end
        rf += 1
    end
    -- globals and the main program's locals
    word s = 1
    while s <= nsy and not failed do
        if not in_frame(s) then data_sym(s) end
        s += 1
    end
    -- one block per function: its parameters and locals (saved as a whole
    -- around recursive calls)
    word fn_ = 1
    while fn_ <= nsy and not failed do
        if sk[fn_] == SK_FUNC then
            ofr(fn_, false)
            os(":\n")
            s = 1
            while s <= nsy do
                if in_frame(s) and sown[s] == fn_ then data_sym(s) end
                s += 1
            end
            ofr(fn_, true)
            os(":\n")
        end
        fn_ += 1
    end
    os("\n; resident estimate: ")
    dec32(word(resident_used >> 16), word(resident_used))
    while ndig > 0 do
        ndig -= 1
        ob(digits[ndig])
    end
    os("\n__program_end:\n")
    oi("ASSERT __program_end <= $FD00, \"main program and data too large\"")
    onl()
    -- the pictures and samples, the banked functions
    asset_pages_out()
    to_file(0)
    file_close(bankh)
    to_file(outh)
    ocopy("bank.asm")
    onl()
    oi("SAVENEX OPEN \"out.nex\", __start, $FDFD")
    oi("SAVENEX CORE 3,0,0")
    oi("SAVENEX CFG 0")
    oi("SAVENEX AUTO")
    oi("SAVENEX CLOSE")
end

-- ---------------------------------------------------------------- main

if load_tokens() then
    if not failed then
        ti = 1
        program()
    end
    if not failed then
        outh = file_open("out.asm", FILE_WRITE)
        bankh = file_open("bank.asm", FILE_WRITE)
        cur_h = outh
        generate()
        flush()
        file_close(outh)
        file_delete("bank.asm")
        file_delete("fn.tmp")
    end
    if failed then
        olen = 0
        file_delete("out.asm")
        outh = file_open("codegen.err", FILE_WRITE)
        cur_h = outh
        os("error ")
        odec(err_l)
        ob(':')
        odec(err_c)
        ob(' ')
        word i = 0
        while i < elen do
            ob(emsg[i])
            i += 1
        end
        onl()
        flush()
        file_close(outh)
        write("error ", err_l, ":", err_c, " ")
        word k = 0
        while k < elen do
            write(chr(emsg[k]))
            k += 1
        end
        print("")
    else
        print("codegen:", nsy, "symbols, out.asm written")
        -- the next stage (lexer -> codegen -> [assets ->] asm)
        bool conv = asset_list()
        if file_exists("chain.on") then
            if conv then
                if not file_exec("nexload assets.nex") then print("cannot start assets.nex, error", file_status) end
            elseif not file_exec("nexload asm.nex") then
                print("cannot start asm.nex, error", file_status)
            end
        end
    end
end
