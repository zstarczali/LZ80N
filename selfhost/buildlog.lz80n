-- selfhost/buildlog.lz80n - the build log of the compiler's stages
--
-- Every stage writes its messages to the screen and to build.log. A stage
-- started by the one before shows the log so far first, so the screen reads
-- like one command line session; the IDE shows the log after a compile.
-- The lexer (the first stage) starts a new log.
--
-- The screen is the 80x32 text mode with the IDE's small font, made to look
-- like the IDE with a window for the log.
--
-- A line is built in log_buf (log_s, log_n, log_c, log_time), then log_end
-- writes it (no string temporaries: the code generator counts them).

word log_t0 = 0
byte log_row = 0            -- the next screen row
byte log_buf[256]
byte log_len = 0

function log_c(byte c)
    if log_len < 250 then
        log_buf[log_len] = c
        log_len += 1
    end
end

function log_s(string s)
    byte i = 0
    while i < len(s) do
        log_c(asc(s, i))
        i += 1
    end
end

function log_n(word v)
    byte d[5]
    byte n = 0
    while v >= 10 do
        d[n] = byte(v % 10)
        n += 1
        v = v / 10
    end
    log_c('0' + byte(v))
    while n > 0 do
        n -= 1
        log_c('0' + d[n])
    end
end

-- the time since log_start: " (1.2 s)"
function log_time()
    word t = frames() - log_t0
    log_s(" (")
    log_n(t / 50)
    log_c('.')
    log_n((t % 50) / 5)
    log_s(" s)")
end

-- The screen looks like the IDE: its menu bar, the program's first lines,
-- the status line, and a window with the log in the middle.
const LB_X = 6              -- the window: columns 6..73, rows 8..23
const LB_W = 68
const LB_Y = 8
const LB_ROWS = 14          -- log rows 9..22
const LB_TEXT = 64          -- characters of a log row
-- colour pairs (attribute = pair * 2)
const LA_DIM = 40
const LA_GUT = 42
const LA_MENU = 44
const LA_TITLE = 46
const LA_STATUS = 48
const LA_BOX = 50
const LA_CYAN = 52
const LA_RED = 54
byte log_pal[16] = {0xE3, 0x6D, 0xE3, 0x49, 0x02, 0xFF, 0x02, 0xFC, 0x49, 0xFF, 0x25, 0xFF, 0x25, 0x1F, 0x25, 0xF5}
byte log_name[64]           -- the program's name (from ide.on)
byte log_nlen = 0

-- the address of a cell of the 80x32 tilemap
function lcell(byte r, byte c) -> word
    return 0x6000 + word(r) * 160 + word(c) * 2
end

-- n cells from (r, c): the character ch, attribute a
function lfill(byte r, byte c, byte n, byte ch, byte a)
    word p = lcell(r, c)
    byte i = 0
    while i < n do
        memory[p] = ch
        memory[p + 1] = a
        p += 2
        i += 1
    end
end

function ltext(byte r, byte c, string t, byte a)
    word p = lcell(r, c)
    byte i = 0
    while i < len(t) and c + i < 80 do
        memory[p] = asc(t, i)
        memory[p + 1] = a
        p += 2
        i += 1
    end
end

-- the program's name and its first lines behind the window
function log_backdrop()
    log_nlen = 0
    byte h = file_open("ide.on", FILE_READ)
    if h ~= FILE_ERROR then
        word c = file_getc(h)
        while c ~= FILE_EOF and c ~= 10 and log_nlen < 60 do
            log_name[log_nlen] = byte(c)
            log_nlen += 1
            c = file_getc(h)
        end
        file_close(h)
    end
    if log_nlen == 0 then
        byte k = 0
        while k < 8 do
            log_name[k] = asc("in.lz80n", k)
            k += 1
        end
        log_nlen = 8
    end
    -- the menu bar, the status line
    lfill(0, 0, 80, ' ', LA_MENU)
    ltext(0, 1, "File  Edit  Build  Help", LA_MENU)
    ltext(0, 30, "LZ80N IDE", LA_TITLE)
    word p = lcell(0, 79 - log_nlen)
    byte k = 0
    while k < log_nlen do
        memory[p] = log_name[k]
        p += 2
        k += 1
    end
    lfill(31, 0, 80, ' ', LA_STATUS)
    ltext(31, 1, "Compiling...  the IDE comes back when it is done", LA_STATUS)
    -- the program's first lines (dim, with line numbers)
    h = file_open("in.lz80n", FILE_READ)
    if h == FILE_ERROR then return end
    byte r = 1
    word c = file_getc(h)
    while r <= 30 and c ~= FILE_EOF do
        -- the line number
        p = lcell(r, 0)
        byte d0 = r / 10
        if d0 ~= 0 then memory[p + 4] = '0' + d0 end
        memory[p + 6] = '0' + r % 10
        k = 0
        while k < 4 do
            memory[p + k * 2 + 1] = LA_GUT
            k += 1
        end
        byte x = 5
        while c ~= FILE_EOF and c ~= 10 do
            if x < 80 and c >= 32 and c < 128 then
                p = lcell(r, x)
                memory[p] = byte(c)
                memory[p + 1] = LA_DIM
                x += 1
            end
            c = file_getc(h)
        end
        if c == 10 then c = file_getc(h) end
        r += 1
    end
    file_close(h)
end

-- the screen: 80x32 text mode, the small font, the IDE's look, the window
function log_screen()
    nextreg[0x6B] = 0xC9
    nextreg[0x6F] = 0x34
    nextreg[0x43] = 0x30
    nextreg[0x40] = 40
    byte k = 0
    while k < 16 do
        nextreg[0x41] = log_pal[k]
        k += 1
    end
    asm
        ld hl,rt_font
        ld de,$7400+32*8
        ld bc,96*8
        ldir
        ld hl,$6000
        ld bc,80*32
.c:
        ld (hl),' '
        inc hl
        ld (hl),40
        inc hl
        dec bc
        ld a,b
        or c
        jr nz,.c
    end
    log_backdrop()
    -- the window: a title row, the log rows, a bottom row
    byte r = LB_Y
    while r < LB_Y + LB_ROWS + 2 do
        lfill(r, LB_X, LB_W, ' ', LA_BOX)
        r += 1
    end
    lfill(LB_Y, LB_X, LB_W, ' ', LA_MENU)
    ltext(LB_Y, LB_X + 2, "Compiling ", LA_MENU)
    word p = lcell(LB_Y, LB_X + 12)
    k = 0
    while k < log_nlen and k < 50 do
        memory[p] = log_name[k]
        memory[p + 1] = LA_TITLE
        p += 2
        k += 1
    end
    log_row = 0
end

-- is "error" or "cannot" in the line?
function log_bad() -> bool
    byte i = 0
    while i + 5 <= log_len do
        if log_buf[i] == 'e' and log_buf[i + 1] == 'r' and log_buf[i + 2] == 'r' and log_buf[i + 3] == 'o' and log_buf[i + 4] == 'r' then return true end
        if i + 6 <= log_len and log_buf[i] == 'c' and log_buf[i + 1] == 'a' and log_buf[i + 2] == 'n' and log_buf[i + 3] == 'n' and log_buf[i + 4] == 'o' and log_buf[i + 5] == 't' then return true end
        i += 1
    end
    return false
end

-- the line in the window (LB_TEXT characters a row; the window scrolls):
-- the first line in cyan, errors in red, the others white
function log_show()
    byte at_ = LA_BOX
    if log_len >= 5 and log_buf[0] == 'L' and log_buf[1] == 'Z' then at_ = LA_CYAN end
    if log_bad() then at_ = LA_RED end
    byte i = 0
    bool first = true
    while first or i < log_len do
        first = false
        if log_row >= LB_ROWS then
            -- up one row: the log rows of the window only
            byte r = 0
            while r < LB_ROWS - 1 do
                sh_from = lcell(LB_Y + 2 + r, LB_X)
                sh_to = lcell(LB_Y + 1 + r, LB_X)
                asm
                    ld hl,(g_sh_from)
                    ld de,(g_sh_to)
                    ld bc,68*2
                    ldir
                end
                r += 1
            end
            lfill(LB_Y + LB_ROWS, LB_X, LB_W, ' ', LA_BOX)
            log_row = LB_ROWS - 1
        end
        word a = lcell(LB_Y + 1 + log_row, LB_X + 2)
        byte x = 0
        while x < LB_TEXT do
            if i < log_len then
                memory[a] = log_buf[i]
                i += 1
            else
                memory[a] = ' '
            end
            memory[a + 1] = at_
            a += 2
            x += 1
        end
        log_row += 1
    end
    log_len = 0
end
word sh_from = 0
word sh_to = 0

-- a line on the screen only
function log_note(string s)
    log_s(s)
    log_show()
end

-- the line on the screen and at the end of build.log
function log_end()
    byte h = file_open("build.log", FILE_APPEND)
    if h ~= FILE_ERROR then
        log_buf[log_len] = 10
        file_write(h, addr(log_buf), log_len + 1)
        file_close(h)
    end
    log_show()
end

function log_say(string s)
    log_s(s)
    log_end()
end

-- the start of a stage: the log so far on the screen (fresh: a new log)
function log_start(bool fresh)
    log_t0 = frames()
    log_len = 0
    log_screen()
    if fresh then
        if file_exists("build.log") then file_delete("build.log") end
        return
    end
    byte h = file_open("build.log", FILE_READ)
    if h == FILE_ERROR then return end
    word c = file_getc(h)
    while c ~= FILE_EOF do
        if c == 10 then log_show() else log_c(byte(c)) end
        c = file_getc(h)
    end
    file_close(h)
    log_len = 0
end

-- start the next program (nexload); a message when it cannot
function log_exec(string nex)
    if not file_exec("nexload " .. nex) then
        log_s("cannot start ")
        log_s(nex)
        log_s(", error ")
        log_n(file_status)
        log_end()
    end
end
