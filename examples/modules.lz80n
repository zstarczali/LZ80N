-- modules.lz80n -- a program in several files
--
-- `include "file"` pastes another source file in at the top level. Paths
-- are relative to the including file; every file is included only once.
--
--   lib/screen.lz80n   title() and status()
--   lib/ball.lz80n     the Ball class (it includes screen.lz80n itself)

include "lib/screen.lz80n"
include "lib/ball.lz80n"

const NBALLS = 6
byte colours[] = {0xE0, 0x1C, 0x03, 0xFC, 0xE3, 0x1F}

Ball balls[NBALLS]
for i = 0, NBALLS - 1 do
    balls[i].start(colours[i])
end

title("Balls from another file")
layer2_visible(true)

while true do
    layer2_clear(rgb(0, 0, 1))
    for i = 0, NBALLS - 1 do
        balls[i].move()
        balls[i].draw()
    end
    layer2_flip()
    status(bounces)
    vsync()
end
