-- move.lz80n -- move a star with Q/A/O/P (or a Kempston joystick)
byte x = 20
byte y = 16

function draw(byte ch)
    at(y, x)
    if ch == 0 then print(" ") else print("*") end
end

print("QAOP/joystick, SPACE=border")
draw(1)
byte colour = BLACK

while true do
    vsync()
    byte joy = kempston()
    if joy == 255 then joy = 0 end   -- no joystick: floating bus
    byte nx = x
    byte ny = y
    if (key(KEY_O) or joy & JOY_LEFT ~= 0) and x > 0 then nx -= 1 end
    if (key(KEY_P) or joy & JOY_RIGHT ~= 0) and x < 39 then nx += 1 end
    if (key(KEY_Q) or joy & JOY_UP ~= 0) and y > 1 then ny -= 1 end
    if (key(KEY_A) or joy & JOY_DOWN ~= 0) and y < 30 then ny += 1 end
    if nx ~= x or ny ~= y then
        draw(0)
        x = nx
        y = ny
        draw(1)
    end
    if key(KEY_SPACE) then
        colour = (colour + 1) & 7
        border(colour)
    end
end
