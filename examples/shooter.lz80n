-- shooter.lz80n -- a little space shooter
--
-- The sprites come from a picture: assets/make_ship_sprites.py cuts the
-- ships of assets/space-ship.png into 16x16 patterns (assets/ships.png).
--
--  * the player and the enemies are 32x32: four hardware sprites each
--  * missiles and explosions are single 16x16 sprites
--  * three layers of stars scroll on Layer 2 (double buffered)
--  * O / P / Q / A or a Kempston joystick to fly, SPACE / fire to shoot

asset sheet = "assets/ships.png"

-- patterns
const PLAYER = 0         -- 3 frames x 4 patterns
const ENEMY = 12         -- 3 frames x 4 patterns
const MISSILE = 24       -- 6 frames
const BOOM = 30          -- 4 frames

-- sprite numbers
const S_PLAYER = 0       -- 0..3
const S_MISSILE = 4      -- 4..9
const S_ENEMY = 10       -- 10..29, four per enemy
const S_BOOM = 30        -- 30..34, one per enemy
const S_PBOOM = 35       -- the player's explosion

const NMISSILES = 6
const NENEMIES = 5
const NSTARS = 48

-- visible area in sprite coordinates: (32,32) .. (287,223)
const LEFT = 32
const RIGHT = 256        -- 288 - 32
const TOP = 32
const BOTTOM = 190

-- ---------------------------------------------------------------- sprites

function put(byte s, word x, word y, byte pat)
    sprite[s].x = x
    sprite[s].y = y
    sprite[s].pattern = pat
    sprite[s].visible = true
    sprite[s].update()
end

-- a 32x32 object: four sprites, patterns pat .. pat + 3
function big(byte s, word x, word y, byte pat)
    put(s, x, y, pat)
    put(s + 1, x + 16, y, pat + 1)
    put(s + 2, x, y + 16, pat + 2)
    put(s + 3, x + 16, y + 16, pat + 3)
end

function big_hide(byte s)
    for k = 0, 3 do
        sprite[s + k].hide()
    end
end

-- ---------------------------------------------------------------- sound

byte laser = 0
word laser_period = 0
byte boom_snd = 0

function sfx_laser()
    laser = 10
    laser_period = 60
end

function sfx_boom()
    boom_snd = 24
    noise(7, 20)
end

function sfx_tick()
    if laser > 0 then
        tone(6, laser_period)
        volume(6, laser + 4)
        laser_period += 30
        laser -= 1
        if laser == 0 then sound_off(6) end
    end
    if boom_snd > 0 then
        volume(7, boom_snd / 2)
        boom_snd -= 1
        if boom_snd == 0 then sound_off(7) end
    end
end

-- ---------------------------------------------------------------- objects

class Missile
    bool active
    word x
    sword y
    byte spr

    function fire(word px, word py)
        self.active = true
        self.x = px
        self.y = sword(py)
    end

    function move()
        if not self.active then return end
        self.y -= 6
        if self.y < 16 then
            self.active = false
            sprite[self.spr].hide()
            return
        end
        put(self.spr, self.x, word(self.y), MISSILE + byte(frames() >> 2) % 6)
    end
end

class Enemy
    word x
    sword y
    word centre
    byte phase
    byte speed
    byte boom            -- explosion timer, 0 = flying
    byte spr
    byte bspr
    byte frame

    function spawn()
        self.y = -32 - sword(random(80))
        self.centre = 70 + random(150)
        self.phase = byte(random(256))
        self.speed = 1 + byte(random(2))
        self.boom = 0
    end

    function move()
        if self.boom > 0 then
            -- exploding: 4 frames, 6 video frames each
            self.boom -= 1
            if self.boom == 0 then
                sprite[self.bspr].hide()
                self.spawn()
            else
                put(self.bspr, self.x + 8, word(self.y + 8), BOOM + (23 - self.boom) / 6)
            end
            return
        end
        self.y += self.speed
        self.phase += 2
        self.x = word(sword(self.centre) + sword(sin(self.phase) * 48))
        if self.y > 230 then self.spawn() end
        if self.y < 0 then
            big_hide(self.spr)
            return
        end
        self.frame = byte(frames() >> 3) % 3
        big(self.spr, self.x, word(self.y), ENEMY + self.frame * 4)
    end

    function explode()
        self.boom = 23
        big_hide(self.spr)
        sfx_boom()
    end

    -- is the point (px, py) inside this enemy's body?
    function hit(word px, sword py) -> bool
        if self.boom > 0 or self.y < 0 then return false end
        return px >= self.x + 4 and px < self.x + 28 and py >= self.y + 4 and py < self.y + 28
    end
end

Missile missiles[NMISSILES]
Enemy enemies[NENEMIES]

-- stars: three speeds, three brightnesses
byte star_x[NSTARS]
byte star_y[NSTARS]
byte star_speed[NSTARS]
byte star_colour[] = {0, 0x49, 0x92, 0xFF}

-- ---------------------------------------------------------------- game

word px = 144
word py = BOTTOM
word score = 0
byte lives = 3
byte cooldown = 0
byte safe = 0            -- invulnerable after a hit (frames)
byte pboom = 0

function hud()
    at(0, 1)
    ink(BRIGHT_YELLOW)
    write("SCORE ", score, "    ")
    at(0, 30)
    ink(BRIGHT_CYAN)
    write("LIVES ", lives)
end

function new_game()
    score = 0
    lives = 3
    px = 144
    py = BOTTOM
    safe = 60
    for i = 0, NENEMIES - 1 do
        enemies[i].spawn()
    end
    for i = 0, NMISSILES - 1 do
        missiles[i].active = false
        sprite[missiles[i].spr].hide()
    end
    cls()
    hud()
end

function fire()
    for i = 0, NMISSILES - 1 do
        if not missiles[i].active then
            missiles[i].fire(px + 8, py - 10)
            sfx_laser()
            cooldown = 8
            return
        end
    end
end

function stars()
    layer2_clear(0)
    for i = 0, NSTARS - 1 do
        star_y[i] += star_speed[i]
        if star_y[i] >= 192 then
            star_y[i] -= 192
            star_x[i] = byte(random(256))
        end
        plot(star_x[i], star_y[i], star_colour[star_speed[i]])
    end
    layer2_flip()
end

function player()
    if pboom > 0 then
        pboom -= 1
        put(S_PBOOM, px + 8, py + 8, BOOM + (31 - pboom) / 8)
        if pboom == 0 then
            sprite[S_PBOOM].hide()
            if lives == 0 then
                at(12, 15)
                ink(BRIGHT_RED)
                write("GAME OVER")
                at(14, 9)
                ink(WHITE)
                write("press SPACE to play")
                while key(KEY_SPACE) do vsync() end
                while not key(KEY_SPACE) do vsync() end
                new_game()
            end
            safe = 90
        end
        return
    end

    byte joy = kempston()
    if (key(KEY_O) or joy & JOY_LEFT ~= 0) and px > LEFT then px -= 3 end
    if (key(KEY_P) or joy & JOY_RIGHT ~= 0) and px < RIGHT then px += 3 end
    if (key(KEY_Q) or joy & JOY_UP ~= 0) and py > TOP + 60 then py -= 2 end
    if (key(KEY_A) or joy & JOY_DOWN ~= 0) and py < BOTTOM then py += 2 end
    if cooldown > 0 then cooldown -= 1 end
    if (key(KEY_SPACE) or joy & JOY_FIRE ~= 0) and cooldown == 0 then fire() end

    -- blink while invulnerable
    if safe > 0 then
        safe -= 1
        if safe & 4 ~= 0 then
            big_hide(S_PLAYER)
            return
        end
    end
    big(S_PLAYER, px, py, PLAYER + byte(frames() >> 2) % 3 * 4)
end

function collisions()
    for e = 0, NENEMIES - 1 do
        for m = 0, NMISSILES - 1 do
            if missiles[m].active and enemies[e].hit(missiles[m].x + 8, missiles[m].y + 4) then
                missiles[m].active = false
                sprite[missiles[m].spr].hide()
                enemies[e].explode()
                score += 10
                hud()
            end
        end
        -- the enemy rams the player
        if safe == 0 and pboom == 0 and enemies[e].hit(px + 16, sword(py) + 12) then
            enemies[e].explode()
            big_hide(S_PLAYER)
            pboom = 31
            lives -= 1
            hud()
        end
    end
end

-- ---------------------------------------------------------------- start

sprite_load(0, sheet)
sprites_visible(true, false)
layer2_visible(true)
border(BLACK)

for i = 0, NMISSILES - 1 do
    missiles[i].spr = S_MISSILE + i
end
for i = 0, NENEMIES - 1 do
    enemies[i].spr = S_ENEMY + i * 4
    enemies[i].bspr = S_BOOM + i
end
for i = 0, NSTARS - 1 do
    star_x[i] = byte(random(256))
    star_y[i] = byte(random(192))
    star_speed[i] = 1 + byte(i % 3)
end

new_game()
while true do
    vsync()
    stars()
    player()
    for i = 0, NMISSILES - 1 do
        missiles[i].move()
    end
    for i = 0, NENEMIES - 1 do
        enemies[i].move()
    end
    collisions()
    sfx_tick()
end
