-- shooter.lz80n -- a little space shooter
--
-- Layer 2 (double buffered). O / P / Q / A or a Kempston joystick to fly,
-- SPACE / fire to shoot.

asset sheet = "assets/ships.png"

-- patterns
const PLAYER = 0         -- 3 frames x 4 patterns
const ENEMY = 12         -- kind k, frame f: ENEMY + 2k + f
const MISSILE = 22       -- 2 frames
const BOOM = 24          -- 4 frames
const BULLET = 28        -- 2 frames

const CRAB = 0
const WASP = 1
const ARROW = 2
const ORB = 3
const BOMBER = 4

-- sprite numbers
const S_PLAYER = 0       -- 0..3
const S_MISSILE = 4      -- 4..9
const S_ENEMY = 10       -- 10..15
const S_BOOM = 16        -- 16..21, one per enemy
const S_BULLET = 22      -- 22..27
const S_PBOOM = 28

const NMISSILES = 6
const NENEMIES = 6
const NBULLETS = 6
const NSTARS = 48

-- visible area in sprite coordinates: (32,32) .. (287,223)
const LEFT = 32
const RIGHT = 256        -- 288 - 32
const TOP = 32
const BOTTOM = 190

byte points[] = {10, 20, 30, 40, 50}

-- ---------------------------------------------------------------- sprites

function put(byte s, word x, word y, byte pat)
    sprite[s].x = x
    sprite[s].y = y
    sprite[s].pattern = pat
    sprite[s].visible = true
    sprite[s].update()
end

-- a 32x32 object: four sprites, patterns pat .. pat + 3
function big(byte s, word x, word y, byte pat)
    put(s, x, y, pat)
    put(s + 1, x + 16, y, pat + 1)
    put(s + 2, x, y + 16, pat + 2)
    put(s + 3, x + 16, y + 16, pat + 3)
end

function big_hide(byte s)
    for k = 0, 3 do
        sprite[s + k].hide()
    end
end

-- ---------------------------------------------------------------- sound

byte laser = 0
word laser_period = 0
byte boom_snd = 0

function sfx_laser()
    laser = 10
    laser_period = 60
end

function sfx_boom()
    boom_snd = 24
    noise(7, 20)
end

function sfx_tick()
    if laser > 0 then
        tone(6, laser_period)
        volume(6, laser + 4)
        laser_period += 30
        laser -= 1
        if laser == 0 then sound_off(6) end
    end
    if boom_snd > 0 then
        volume(7, boom_snd / 2)
        boom_snd -= 1
        if boom_snd == 0 then sound_off(7) end
    end
end

-- ---------------------------------------------------------------- game state

word px = 144
word py = BOTTOM
word score = 0
byte lives = 3
byte cooldown = 0
byte safe = 0            -- invulnerable after a hit (frames)
byte pboom = 0

-- ---------------------------------------------------------------- objects

class Missile
    bool active
    word x
    sword y
    byte spr

    function fire(word mx, word my)
        self.active = true
        self.x = mx
        self.y = sword(my)
    end

    function move()
        if not self.active then return end
        self.y -= 6
        if self.y < 16 then
            self.active = false
            sprite[self.spr].hide()
            return
        end
        put(self.spr, self.x, word(self.y), MISSILE + byte(frames() >> 2) % 2)
    end
end

class Bullet
    bool active
    sword x
    sword y
    sword dx
    byte spr

    function move()
        if not self.active then return end
        self.y += 3
        self.x += self.dx
        if self.y > 232 or self.x < 16 or self.x > 290 then
            self.active = false
            sprite[self.spr].hide()
            return
        end
        put(self.spr, word(self.x), word(self.y), BULLET + byte(frames() >> 3) % 2)
    end
end

Bullet bullets[NBULLETS]

-- an enemy shoots at the player (if a bullet is free)
function shoot(word x, sword y)
    for i = 0, NBULLETS - 1 do
        if not bullets[i].active then
            bullets[i].active = true
            bullets[i].x = sword(x)
            bullets[i].y = y + 8
            bullets[i].dx = 0
            if px > x + 8 then bullets[i].dx = 1 end
            if px + 24 < x then bullets[i].dx = -1 end
            return
        end
    end
end

class Enemy
    byte kind
    word x
    sword y
    word centre
    byte phase
    byte speed
    byte amp             -- sway width
    byte step            -- sway speed
    byte health
    byte boom            -- explosion timer, 0 = flying
    byte spr
    byte bspr

    function spawn()
        -- more kinds join as the score grows
        byte kinds = byte(min(5, 2 + score / 150))
        self.kind = byte(random(kinds))
        self.y = -40 - sword(random(100))
        self.centre = 70 + random(150)
        self.phase = byte(random(256))
        self.boom = 0
        self.health = 1
        if self.kind == CRAB then
            self.speed = 1
            self.amp = 48
            self.step = 2
        elseif self.kind == WASP then
            self.speed = 2
            self.amp = 24
            self.step = 7
        elseif self.kind == ARROW then
            self.speed = 3
            self.amp = 0
            self.step = 0
        elseif self.kind == ORB then
            self.speed = 1
            self.amp = 32
            self.step = 1
        else
            self.speed = 1
            self.amp = 8
            self.step = 1
            self.health = 3
        end
    end

    function move()
        if self.boom > 0 then
            -- exploding: 4 frames, 6 video frames each
            self.boom -= 1
            if self.boom == 0 then
                sprite[self.bspr].hide()
                self.spawn()
            else
                put(self.bspr, self.x, word(self.y), BOOM + (23 - self.boom) / 6)
            end
            return
        end
        self.y += self.speed
        if self.kind == ARROW then
            -- steer towards the player
            if self.centre < px + 4 then self.centre += 1 end
            if self.centre > px + 12 then self.centre -= 1 end
        end
        self.phase += self.step
        self.x = word(sword(self.centre) + sword(sin(self.phase) * self.amp))
        if self.y > 230 then self.spawn() end
        if self.y < 0 then
            sprite[self.spr].hide()
            return
        end
        if (self.kind == ORB or self.kind == BOMBER) and self.y < 150 and random(90) == 0 then
            shoot(self.x, self.y)
        end
        put(self.spr, self.x, word(self.y), ENEMY + self.kind * 2 + byte(frames() >> 3) % 2)
    end

    -- hit by a missile: true when destroyed
    function damage() -> bool
        self.health -= 1
        if self.health > 0 then
            self.y -= 4                  -- knocked back
            return false
        end
        self.boom = 23
        sprite[self.spr].hide()
        sfx_boom()
        return true
    end

    -- is the point (hx, hy) inside this enemy's body (16x16)?
    function hit(word hx, sword hy) -> bool
        if self.boom > 0 or self.y < 0 then return false end
        return hx >= self.x + 1 and hx < self.x + 15 and hy >= self.y + 2 and hy < self.y + 14
    end

    -- does this enemy overlap the player's body (px+6..px+26, py+4..py+28)?
    function touches() -> bool
        if self.boom > 0 or self.y < 0 then return false end
        sword top = sword(py)
        return self.x + 14 > px + 6 and self.x + 2 < px + 26 and self.y + 14 > top + 4 and self.y + 2 < top + 28
    end
end

Missile missiles[NMISSILES]
Enemy enemies[NENEMIES]

-- stars: three speeds, three brightnesses
byte star_x[NSTARS]
byte star_y[NSTARS]
byte star_speed[NSTARS]
byte star_colour[] = {0, 0x49, 0x92, 0xFF}

-- ---------------------------------------------------------------- game

function hud()
    at(0, 1)
    ink(BRIGHT_YELLOW)
    write("SCORE ", score, "    ")
    at(0, 32)
    ink(BRIGHT_CYAN)
    write("LIVES ", lives)
end

function new_game()
    score = 0
    lives = 3
    px = 144
    py = BOTTOM
    safe = 60
    for i = 0, NENEMIES - 1 do
        enemies[i].spawn()
    end
    for i = 0, NMISSILES - 1 do
        missiles[i].active = false
        sprite[missiles[i].spr].hide()
    end
    for i = 0, NBULLETS - 1 do
        bullets[i].active = false
        sprite[bullets[i].spr].hide()
    end
    cls()
    hud()
end

function fire()
    for i = 0, NMISSILES - 1 do
        if not missiles[i].active then
            missiles[i].fire(px + 8, py - 10)
            sfx_laser()
            cooldown = 8
            return
        end
    end
end

-- draw the stars into the hidden Layer 2 buffer
function stars()
    layer2_clear(0)
    for i = 0, NSTARS - 1 do
        star_y[i] += star_speed[i]
        if star_y[i] >= 192 then
            star_y[i] -= 192
            star_x[i] = byte(random(256))
        end
        plot(star_x[i], star_y[i], star_colour[star_speed[i]])
    end
end

function player_hit()
    big_hide(S_PLAYER)
    pboom = 31
    lives -= 1
    sfx_boom()
    hud()
end

function player()
    if pboom > 0 then
        pboom -= 1
        put(S_PBOOM, px, py, BOOM + (31 - pboom) / 8)
        if pboom == 0 then
            sprite[S_PBOOM].hide()
            if lives == 0 then
                -- clear the sky: hide every sprite but the stars stay
                for k = S_MISSILE, S_PBOOM do
                    sprite[k].hide()
                end
                -- centred on the 40-column text layer
                at(12, 15)
                ink(BRIGHT_RED)
                write("GAME OVER")
                at(14, 10)
                ink(WHITE)
                write("press SPACE to play")
                while key(KEY_SPACE) do vsync() end
                while not key(KEY_SPACE) do vsync() end
                new_game()
            end
            safe = 90
        end
        return
    end

    byte joy = kempston()
    if (key(KEY_O) or joy & JOY_LEFT ~= 0) and px > LEFT then px -= 3 end
    if (key(KEY_P) or joy & JOY_RIGHT ~= 0) and px < RIGHT then px += 3 end
    if (key(KEY_Q) or joy & JOY_UP ~= 0) and py > TOP + 60 then py -= 2 end
    if (key(KEY_A) or joy & JOY_DOWN ~= 0) and py < BOTTOM then py += 2 end
    if cooldown > 0 then cooldown -= 1 end
    if (key(KEY_SPACE) or joy & JOY_FIRE ~= 0) and cooldown == 0 then fire() end

    -- blink while invulnerable
    if safe > 0 then
        safe -= 1
        if safe & 4 ~= 0 then
            big_hide(S_PLAYER)
            return
        end
    end
    big(S_PLAYER, px, py, PLAYER + byte(frames() >> 2) % 3 * 4)
end

function collisions()
    for e = 0, NENEMIES - 1 do
        for m = 0, NMISSILES - 1 do
            if missiles[m].active and enemies[e].hit(missiles[m].x + 8, missiles[m].y + 4) then
                missiles[m].active = false
                sprite[missiles[m].spr].hide()
                if enemies[e].damage() then
                    score += points[enemies[e].kind]
                    hud()
                end
            end
        end
        -- the enemy rams the player
        if safe == 0 and pboom == 0 and enemies[e].touches() then
            enemies[e].health = 1
            enemies[e].damage()
            player_hit()
        end
    end
    if safe == 0 and pboom == 0 then
        for b = 0, NBULLETS - 1 do
            if bullets[b].active then
                sword bx = bullets[b].x + 8
                sword by = bullets[b].y + 8
                if bx >= sword(px) + 8 and bx < sword(px) + 24 and by >= sword(py) + 4 and by < sword(py) + 28 then
                    bullets[b].active = false
                    sprite[bullets[b].spr].hide()
                    player_hit()
                    return
                end
            end
        end
    end
end

-- ---------------------------------------------------------------- start

sprite_load(0, sheet)
sprites_visible(true, false)
layer2_visible(true)
border(BLACK)

for i = 0, NMISSILES - 1 do
    missiles[i].spr = S_MISSILE + i
end
for i = 0, NBULLETS - 1 do
    bullets[i].spr = S_BULLET + i
end
for i = 0, NENEMIES - 1 do
    enemies[i].spr = S_ENEMY + i
    enemies[i].bspr = S_BOOM + i
end
for i = 0, NSTARS - 1 do
    star_x[i] = byte(random(256))
    star_y[i] = byte(random(192))
    star_speed[i] = 1 + byte(i % 3)
end

new_game()
while true do
    vsync()
    -- right after the frame interrupt: show the finished stars and move
    -- every sprite before the beam reaches the screen
    layer2_flip()
    player()
    for i = 0, NMISSILES - 1 do
        missiles[i].move()
    end
    for i = 0, NENEMIES - 1 do
        enemies[i].move()
    end
    for i = 0, NBULLETS - 1 do
        bullets[i].move()
    end
    collisions()
    sfx_tick()
    stars()              -- the next frame's stars, into the hidden buffer
end
