-- recursion.lz80n -- functions that call themselves
--
--  * a fractal tree: every branch draws two smaller branches
--  * the Towers of Hanoi, solved recursively
--  * mutual recursion: is_even() and is_odd() call each other
--
-- Recursive calls keep their parameters and locals on the stack; ordinary
-- calls cost nothing extra.

word moves = 0

-- a branch from (x, y) towards `angle` (0..255 = a full turn); at its end
-- two shorter branches grow, turned left and right
function branch(byte x, byte y, byte angle, byte len, byte depth)
    sword x2 = sword(x) + sword(cos(angle) * len)
    sword y2 = sword(y) - sword(sin(angle) * len)
    if x2 < 0 or x2 > 255 or y2 < 0 or y2 > 191 then return end
    byte c = rgb(7 - depth / 2, 2 + depth / 2, 0)
    if depth >= 6 then c = rgb(1, 7, 1) end
    line(x, y, byte(x2), byte(y2), c)
    if depth == 9 then return end
    byte shorter = len * 3 / 4
    branch(byte(x2), byte(y2), angle + 22, shorter, depth + 1)
    branch(byte(x2), byte(y2), angle - 18, shorter, depth + 1)
end

-- move n discs from one peg to another
function hanoi(byte n, byte from, byte to, byte via)
    if n == 0 then return end
    hanoi(n - 1, from, via, to)
    moves += 1
    hanoi(n - 1, via, to, from)
end

function is_even(byte n) -> bool
    if n == 0 then return true end
    return is_odd(n - 1)
end

function is_odd(byte n) -> bool
    if n == 0 then return false end
    return is_even(n - 1)
end

function factorial(word n) -> word
    if n <= 1 then return 1 end
    return n * factorial(n - 1)
end

layer2_visible(true)
layer2_clear(rgb(0, 0, 1))
branch(128, 190, 64, 36, 0)         -- the trunk points up (64 = 90 degrees)
layer2_flip()

ink(BRIGHT_YELLOW)
at(0, 1)
write("Recursion")
ink(BRIGHT_WHITE)
hanoi(12, 1, 3, 2)
at(2, 1)
write("Hanoi, 12 discs: ", moves, " moves")
at(3, 1)
write("8! = ", factorial(8))
at(4, 1)
write("is_even(77): ", is_even(77))

while true do
    vsync()
end
